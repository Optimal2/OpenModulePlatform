@* File: OpenModulePlatform.Web.ContentWebAppModule/Pages/Admin/Edit.cshtml *@
@page "{contentId:guid?}"
@inject OpenModulePlatform.Web.Shared.Services.OmpTime OmpTime
@model OpenModulePlatform.Web.ContentWebAppModule.Pages.Admin.EditModel

@section Styles {
    <link rel="stylesheet" href="~/lib/toastui-editor/toastui-editor.min.css" />
}

<div class="page-header">
    <div>
        <div class="eyebrow">@L["Content"]</div>
        <h1>@(Model.IsCreate ? L["New page"] : L["Edit page"])</h1>
        <p class="lede">@L["Choose a content type first. Markdown, HTML, HTML files, and server reports each use a dedicated editor."]</p>
    </div>
    <div class="toolbar">
        <a class="button" href="~/admin">@L["Back to pages"]</a>
        @if (!Model.IsCreate)
        {
            <a class="button" href="~/admin/preview?contentId=@Model.Input.ContentId">@L["Preview"]</a>
        }
    </div>
</div>

@await Component.InvokeAsync("OmpFeedback", new { message = Model.StatusMessage, includeValidationSummary = false })

<form method="post" class="card form-grid" id="content-edit-form">
    <input type="hidden" asp-for="Input.ContentId" />
    <input type="hidden" asp-for="Input.IsEnabled" />
    <input type="hidden" asp-for="Input.CreatedAtUtc" />
    <input type="hidden" asp-for="Input.CreatedBy" />
    <input type="hidden" asp-for="Input.UpdatedAtUtc" />
    <input type="hidden" asp-for="Input.UpdatedBy" />

    <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>

    <div class="form-row">
        <div class="form-field">
            <label asp-for="Input.Title"></label>
            <input asp-for="Input.Title" />
            <span asp-validation-for="Input.Title" class="field-validation-error"></span>
        </div>
        <div class="form-field">
            <label asp-for="Input.Slug"></label>
            <input asp-for="Input.Slug" placeholder="help/faq" />
            <span class="field-hint">@L["Slugs are normalized when saved."]</span>
            <span asp-validation-for="Input.Slug" class="field-validation-error"></span>
        </div>
    </div>

    <div class="form-row">
        <div class="form-field">
            <label asp-for="Input.ContentType"></label>
            @if (!Model.IsCreate)
            {
                <input type="hidden" name="Input.ContentType" value="@Model.Input.ContentType" />
            }
            <select asp-for="Input.ContentType" disabled="@(!Model.IsCreate)">
                <option value="markdown">@L["Markdown"]</option>
                <option value="html">@L["HTML"]</option>
                <option value="html_file">@L["HTML file"]</option>
                <option value="server_report">@L["Server report"]</option>
            </select>
            @if (!Model.IsCreate)
            {
                <span class="field-hint">@L["Content type is locked after the page has been created."]</span>
            }
        </div>
        <div class="form-field">
            <label asp-for="Input.SortOrder"></label>
            <input asp-for="Input.SortOrder" type="number" />
        </div>
    </div>

    @{
        var currentServerReportKey = Model.Input.ServerReportKey;
        var currentReportKeyMissing = !string.IsNullOrWhiteSpace(currentServerReportKey)
            && !Model.AvailableServerReportKeys.Contains(currentServerReportKey, StringComparer.OrdinalIgnoreCase);
        var currentHtmlFileKey = Model.Input.HtmlFileKey;
        var currentHtmlFileKeyMissing = !string.IsNullOrWhiteSpace(currentHtmlFileKey)
            && !Model.AvailableHtmlFileKeys.Contains(currentHtmlFileKey, StringComparer.OrdinalIgnoreCase);
    }

    <div class="form-field" data-server-report-field hidden="@(Model.Input.ContentType != "server_report")">
        <label asp-for="Input.ServerReportKey"></label>
        <select asp-for="Input.ServerReportKey">
            <option value="">@L["Choose a server report"]</option>
            @foreach (var reportKey in Model.AvailableServerReportKeys)
            {
                <option value="@reportKey">@reportKey</option>
            }
            @if (currentReportKeyMissing)
            {
                <option value="@currentServerReportKey">@currentServerReportKey (@L["missing"])</option>
            }
        </select>
        <span class="field-hint">@L["Server reports are JSON files in the server report directory. SQL is not edited here."]</span>
        <span asp-validation-for="Input.ServerReportKey" class="field-validation-error"></span>
    </div>

    <div class="form-field" data-html-file-field hidden="@(Model.Input.ContentType != "html_file")">
        <label asp-for="Input.HtmlFileKey"></label>
        <select asp-for="Input.HtmlFileKey">
            <option value="">@L["Choose an HTML file"]</option>
            @foreach (var htmlFileKey in Model.AvailableHtmlFileKeys)
            {
                <option value="@htmlFileKey">@htmlFileKey</option>
            }
            @if (currentHtmlFileKeyMissing)
            {
                <option value="@currentHtmlFileKey">@currentHtmlFileKey (@L["missing"])</option>
            }
        </select>
        <span class="field-hint">@L["HTML files are read from the configured HTML file directory or packaged ContentPages folder. Server report shortcodes are supported."]</span>
        <span asp-validation-for="Input.HtmlFileKey" class="field-validation-error"></span>
    </div>

    <div class="form-field content-editor-field" data-content-editor-field hidden="@(Model.Input.ContentType == "server_report" || Model.Input.ContentType == "html_file")">
        <label asp-for="Input.Body"></label>
        <div class="editor-tabs" data-editor-tabs hidden>
            <button type="button" class="editor-tab" data-editor-mode="visual" aria-selected="true">@L["Visual"]</button>
            <button
                type="button"
                class="editor-tab"
                data-editor-mode="source"
                data-html-source-label="@L["HTML source"]"
                data-markdown-source-label="@L["Markdown source"]"
                aria-selected="false">@L["Markdown source"]</button>
        </div>
        <div id="content-editor" class="content-editor" hidden></div>
        <div class="omp-feedback__alert status-banner" role="alert" data-editor-warning hidden>@L["The visual editor cannot be used for this page because it would change the HTML. Edit the HTML source instead."]</div>
        <textarea asp-for="Input.Body" rows="18" class="content-editor__source"></textarea>
        <span class="field-hint" data-editor-hint="markdown">@L["Write Markdown content. Server report shortcodes such as DB_JSON are supported."]</span>
        <span class="field-hint" data-editor-hint="html" hidden>@L["Write trusted HTML directly. Server report shortcodes such as DB_JSON and DB_JSON_SCRIPT are supported."]</span>
        <span class="field-hint">@L["Changing content type changes the editor but does not convert existing content."]</span>
        <span asp-validation-for="Input.Body" class="field-validation-error"></span>
    </div>

    @if (Model.CanManageAll)
    {
        <section class="access-panel">
            <div>
                <h2>@L["Role access"]</h2>
                <p class="muted">@L["Roles with read access can view the page. Roles with write access can edit it."]</p>
            </div>
            @if (Model.Input.RoleAccesses.Count == 0)
            {
                <div class="empty-state">@L["No roles are configured."]</div>
            }
            else
            {
                <table class="grid access-grid">
                    <thead>
                        <tr>
                            <th>@L["Role"]</th>
                            <th>@L["Read"]</th>
                            <th>@L["Write"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < Model.Input.RoleAccesses.Count; i++)
                    {
                        <tr>
                            <td>
                                <input type="hidden" asp-for="Input.RoleAccesses[i].RoleId" />
                                <input type="hidden" asp-for="Input.RoleAccesses[i].RoleName" />
                                @Model.Input.RoleAccesses[i].RoleName
                            </td>
                            <td>
                                <input asp-for="Input.RoleAccesses[i].CanRead" type="checkbox" />
                            </td>
                            <td>
                                <input asp-for="Input.RoleAccesses[i].CanWrite" type="checkbox" />
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </section>
    }
    else
    {
        @for (var i = 0; i < Model.Input.RoleAccesses.Count; i++)
        {
            <input type="hidden" asp-for="Input.RoleAccesses[i].RoleId" />
            <input type="hidden" asp-for="Input.RoleAccesses[i].RoleName" />
            <input type="hidden" asp-for="Input.RoleAccesses[i].CanRead" />
            <input type="hidden" asp-for="Input.RoleAccesses[i].CanWrite" />
        }
    }

    <div class="toolbar">
        <button type="submit" asp-page-handler="Save" class="button--primary">@L["Save page"]</button>
        @if (!Model.IsCreate && Model.CanManageAll)
        {
            @if (Model.Input.IsEnabled)
            {
                <button type="submit" asp-page-handler="Disable" class="button--danger" formnovalidate>@L["Disable"]</button>
            }
            else
            {
                <button type="submit" asp-page-handler="Enable" class="button--secondary" formnovalidate>@L["Enable"]</button>
            }
        }
    </div>
</form>

@if (!Model.IsCreate && Model.CanManageAll)
{
    <form
        method="post"
        asp-page-handler="Delete"
        class="card danger-zone"
        data-omp-confirm="@L["Delete this page permanently?"]"
        data-omp-confirm-ok="@L["Delete"]"
        data-omp-confirm-cancel="@L["Cancel"]">
        <input type="hidden" asp-for="Input.ContentId" />
        <h2>@L["Delete page"]</h2>
        <p class="muted">@L["Delete removes the page and its role access rows. It cannot be undone."]</p>
        <button type="submit" class="button--danger">@L["Delete permanently"]</button>
    </form>
}

@if (!Model.IsCreate)
{
    <section class="card content-metadata">
        <h2>@L["Metadata"]</h2>
        <dl>
            <dt>@L["Content ID"]</dt>
            <dd><code>@Model.Input.ContentId</code></dd>
            <dt>@L["Created"]</dt>
            <dd>@OmpTime.Format(Model.Input.CreatedAtUtc) <span class="muted">@Model.Input.CreatedBy</span></dd>
            <dt>@L["Updated"]</dt>
            <dd>@OmpTime.Format(Model.Input.UpdatedAtUtc) <span class="muted">@Model.Input.UpdatedBy</span></dd>
        </dl>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/toastui-editor/toastui-editor-all.min.js"></script>
    <script>
        (() => {
            const source = document.getElementById('Input_Body');
            const host = document.getElementById('content-editor');
            const editorTabs = document.querySelector('[data-editor-tabs]');
            const editorTabButtons = Array.from(document.querySelectorAll('[data-editor-mode]'));
            const sourceTab = document.querySelector('[data-editor-mode="source"]');
            const visualTab = document.querySelector('[data-editor-mode="visual"]');
            const editorWarning = document.querySelector('[data-editor-warning]');
            const form = document.getElementById('content-edit-form');
            const contentType = document.getElementById('Input_ContentType');
            const editorField = document.querySelector('[data-content-editor-field]');
            const htmlFileField = document.querySelector('[data-html-file-field]');
            const reportField = document.querySelector('[data-server-report-field]');
            const markdownHint = document.querySelector('[data-editor-hint="markdown"]');
            const htmlHint = document.querySelector('[data-editor-hint="html"]');
            let toastEditor = null;
            let toastEditorContentType = null;
            // Baseline captured from the editor right after every programmatic
            // set. A programmatic set fires the editor's change event too, so
            // the change event cannot be used as the "the user edited" signal.
            let editorBaseline = null;
            let editorMode = 'source';
            let previousType = null;

            const getToastEditorValue = (type) => {
                if (!toastEditor) {
                    return source?.value || '';
                }

                if (type === 'html' && typeof toastEditor.getHTML === 'function') {
                    return toastEditor.getHTML();
                }

                return toastEditor.getMarkdown();
            };

            const setToastEditorValue = (type, value) => {
                if (!toastEditor) {
                    return;
                }

                if (type === 'html' && typeof toastEditor.setHTML === 'function') {
                    toastEditor.setHTML(value || '');
                }
                else {
                    toastEditor.setMarkdown(value || '');
                }

                toastEditorContentType = type;

                // Capture the baseline immediately after the programmatic set so
                // that a later comparison tells a user edit from a plain load.
                editorBaseline = getToastEditorValue(type);
            };

            // The visual editor is only trustworthy when it hands back what it
            // was given. The comparison runs on the parsed DOM and ignores
            // whitespace-only differences, so a cosmetic reformat does not
            // count as a change while a lost element, attribute or query
            // parameter does.
            const parseHtmlBody = (html) =>
                new DOMParser().parseFromString(html || '', 'text/html').body;

            const normalizeText = (text) => (text || '').replace(/\s+/g, ' ').trim();

            const significantChildren = (element) => Array.from(element.childNodes).filter((node) =>
                node.nodeType !== Node.TEXT_NODE || normalizeText(node.nodeValue).length > 0);

            const sameHtmlNode = (left, right) => {
                if (!left || !right || left.nodeType !== right.nodeType) {
                    return false;
                }

                if (left.nodeType === Node.TEXT_NODE) {
                    return normalizeText(left.nodeValue) === normalizeText(right.nodeValue);
                }

                if (left.nodeType !== Node.ELEMENT_NODE) {
                    return (left.nodeValue || '') === (right.nodeValue || '');
                }

                if (left.tagName !== right.tagName) {
                    return false;
                }

                const leftAttributes = Array.from(left.attributes)
                    .map((attribute) => `${attribute.name}=${attribute.value}`)
                    .sort();
                const rightAttributes = Array.from(right.attributes)
                    .map((attribute) => `${attribute.name}=${attribute.value}`)
                    .sort();

                if (leftAttributes.length !== rightAttributes.length
                    || !leftAttributes.every((attribute, index) => attribute === rightAttributes[index])) {
                    return false;
                }

                const leftChildren = significantChildren(left);
                const rightChildren = significantChildren(right);

                if (leftChildren.length !== rightChildren.length) {
                    return false;
                }

                return leftChildren.every((child, index) => sameHtmlNode(child, rightChildren[index]));
            };

            // Round trips the source through the visual editor without touching
            // the textarea. The editor keeps the probed value, so the baseline
            // is captured again by the set.
            const htmlRoundTripIsLossless = (html) => {
                if (!toastEditor
                    || typeof toastEditor.setHTML !== 'function'
                    || typeof toastEditor.getHTML !== 'function') {
                    return false;
                }

                setToastEditorValue('html', html || '');
                const original = parseHtmlBody(html || '');
                const roundTripped = parseHtmlBody(getToastEditorValue('html'));
                return sameHtmlNode(original, roundTripped);
            };

            const setVisualTabAvailability = (available) => {
                if (!visualTab) {
                    return;
                }

                // Without the editor asset the visual tab cannot be offered at
                // all; the textarea keeps saving the page on its own.
                if (!window.toastui?.Editor) {
                    visualTab.hidden = true;
                    visualTab.dataset.editorVisualUnavailable = 'true';
                    return;
                }

                // The tab stays clickable: a click on a page the visual editor
                // would change explains that instead of doing nothing.
                visualTab.hidden = false;
                visualTab.dataset.editorVisualUnavailable = available ? 'false' : 'true';
            };

            const showEditorWarning = (visible) => {
                if (editorWarning) {
                    editorWarning.hidden = !visible;
                }
            };

            // True only when the editor holds something else than the baseline
            // captured after the last programmatic set. Opening a page or
            // switching tabs never changes the stored body this way.
            const isVisualEditorDirty = (type) => {
                if (!toastEditor || editorBaseline === null) {
                    return false;
                }

                return getToastEditorValue(type) !== editorBaseline;
            };

            const pullVisualEditorValue = (type = contentType?.value || 'markdown') => {
                if (!source || !toastEditor || editorMode !== 'visual') {
                    return;
                }

                const editorType = toastEditorContentType || type;
                if (!isVisualEditorDirty(editorType)) {
                    return;
                }

                const value = getToastEditorValue(editorType);
                source.value = value;
                editorBaseline = value;
            };

            const ensureToastEditor = (type, forceValueSync = false) => {
                if (!source || !host || !window.toastui?.Editor) {
                    return;
                }

                if (!toastEditor) {
                    toastEditor = new toastui.Editor({
                        el: host,
                        height: '520px',
                        initialEditType: 'wysiwyg',
                        previewStyle: 'tab',
                        hideModeSwitch: true,
                        initialValue: ''
                    });
                }

                if (forceValueSync || toastEditorContentType !== type) {
                    setToastEditorValue(type, source.value || '');
                }

                if (editorMode === 'visual') {
                    host.hidden = false;
                    source.classList.add('is-enhanced');
                }
            };

            const updateEditorTabs = (type) => {
                if (!editorTabs || !sourceTab) {
                    return;
                }

                sourceTab.textContent = type === 'html'
                    ? (sourceTab.dataset.htmlSourceLabel || 'HTML source')
                    : (sourceTab.dataset.markdownSourceLabel || 'Markdown source');

                for (const button of editorTabButtons) {
                    button.setAttribute('aria-selected', button.dataset.editorMode === editorMode ? 'true' : 'false');
                }
            };

            const setEditorMode = (mode) => {
                if (!source) {
                    return;
                }

                const type = contentType?.value || 'markdown';
                const nextMode = mode === 'source' ? 'source' : 'visual';

                if ((type === 'markdown' || type === 'html') && editorMode === 'visual' && nextMode === 'source') {
                    pullVisualEditorValue();
                }

                editorMode = nextMode;
                if (editorMode === 'visual') {
                    ensureToastEditor(type, true);
                    if (toastEditor && host) {
                        host.hidden = false;
                        source.classList.add('is-enhanced');
                    }
                    else if (host) {
                        host.hidden = true;
                        source.classList.remove('is-enhanced');
                    }
                }
                else {
                    if (host) {
                        host.hidden = true;
                    }

                    source.classList.remove('is-enhanced');
                }

                updateEditorTabs(type);
            };

            for (const button of editorTabButtons) {
                button.addEventListener('click', () => {
                    const mode = button.dataset.editorMode;
                    const type = contentType?.value || 'markdown';

                    if (mode === 'visual' && type === 'html') {
                        // The source may have been edited since the page was
                        // loaded, so the round trip is checked again here. A
                        // page that does not survive it keeps its source.
                        const lossless = htmlRoundTripIsLossless(source?.value || '');
                        setVisualTabAvailability(lossless);
                        showEditorWarning(!lossless);

                        if (!lossless) {
                            return;
                        }
                    }

                    setEditorMode(mode);
                });
            }

            const hideEnhancedEditors = () => {
                pullVisualEditorValue(previousType || contentType?.value || 'markdown');

                if (host) {
                    host.hidden = true;
                }

                if (editorTabs) {
                    editorTabs.hidden = true;
                }

                source?.classList.remove('is-enhanced');
                setVisualTabAvailability(false);
                showEditorWarning(false);
            };

            const syncContentType = () => {
                const type = contentType?.value || 'markdown';
                const isServerReport = type === 'server_report';
                const isHtmlFile = type === 'html_file';
                const isHtml = type === 'html';
                const typeChanged = previousType !== null && previousType !== type;
                if (typeChanged) {
                    // The editor still holds the previous type's content: pull it
                    // back (only when the user actually changed it) before the
                    // editor is switched to the new type.
                    pullVisualEditorValue(previousType);
                }

                // HTML pages open in the source tab, Markdown pages in the
                // visual tab. Choosing HTML on the create page therefore lands
                // in the source tab.
                editorMode = type === 'html' ? 'source' : 'visual';

                if (editorField) {
                    editorField.hidden = isServerReport || isHtmlFile;
                }

                if (htmlFileField) {
                    htmlFileField.hidden = !isHtmlFile;
                }

                if (reportField) {
                    reportField.hidden = !isServerReport;
                }

                if (markdownHint) {
                    markdownHint.hidden = isServerReport || isHtmlFile || isHtml;
                }

                if (htmlHint) {
                    htmlHint.hidden = isServerReport || isHtmlFile || !isHtml;
                }

                if (isServerReport || isHtmlFile) {
                    hideEnhancedEditors();
                    source?.classList.remove('content-editor__source--html');
                }
                else if (isHtml) {
                    if (editorTabs) {
                        editorTabs.hidden = false;
                    }

                    source?.classList.add('content-editor__source--html');
                    ensureToastEditor(type, typeChanged);

                    // The visual tab is only offered for a page that survives the
                    // round trip through the visual editor unchanged.
                    const lossless = htmlRoundTripIsLossless(source?.value || '');
                    setVisualTabAvailability(lossless);
                    showEditorWarning(!lossless);
                    setEditorMode(editorMode);
                }
                else {
                    if (editorTabs) {
                        editorTabs.hidden = false;
                    }

                    source?.classList.remove('content-editor__source--html');
                    ensureToastEditor(type, typeChanged);
                    setVisualTabAvailability(true);
                    showEditorWarning(false);
                    setEditorMode(editorMode);
                }

                previousType = type;
            };

            contentType?.addEventListener('change', syncContentType);
            syncContentType();

            if (!source || !form || !contentType) {
                return;
            }

            form.addEventListener('submit', () => {
                if (contentType.value === 'server_report' || contentType.value === 'html_file') {
                    source.value = '';
                    return;
                }

                if (contentType.value === 'markdown' || contentType.value === 'html') {
                    pullVisualEditorValue();
                }
            });
        })();
    </script>
}
