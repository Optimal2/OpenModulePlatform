// File: OpenModulePlatform.Web.ContentWebAppModule/appsettings.json
{
  "ConnectionStrings": {
    "OmpDb": "Server=localhost;Database=OpenModulePlatform;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Portal": {
    "Title": "Content",
    "DefaultCulture": "sv-SE",
    "SupportedCultures": [ "sv-SE", "en-US" ],
    "PortalTopBar": {
      "Enabled": true,
      "PortalBaseUrl": "/"
    },
    "AllowAnonymous": false,
    "PermissionMode": "Any",
    "SecurityHeaders": {
      "ContentSecurityPolicy": {
        "//": "Baseline plus https: in img-src (trusted DB/file-driven content may reference external images by design). The TOAST UI editor is vendored under wwwroot/lib/toastui-editor since campaign csp-vagen-till-enforcement, so no third-party script/style origin remains. script-src keeps 'unsafe-inline' because trusted HTML content and the admin editor bootstrap (Pages/Admin/Edit.cshtml) still carry inline scripts. See docs/CONTENT_SECURITY_POLICY.md.",
        "Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' ws: wss:; media-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'self'; frame-ancestors 'self'"
      }
    }
  },
  "ContentWebAppModule": {
    "AppInstanceId": "11111111-1111-1111-1111-111111111232",
    "HomeSlug": "home",
    "ServerReportsPath": "App_Data/ContentReports",
    "HtmlFilesPath": "App_Data/ContentPages",
    "AllowedServerReportDatabases": [ "OpenModulePlatform" ],
    "ServerReportDefaultMaxRows": 100,
    "ServerReportMaxRowsLimit": 1000,
    "ServerReportQueryTimeoutSeconds": 30
  },
  "OmpAuth": {
    "CookieName": ".OpenModulePlatform.Auth",
    "LoginPath": "/auth/login",
    "LogoutPath": "/auth/logout",
    "AccessDeniedPath": "/status/403",
    "ApplicationName": "OpenModulePlatform"
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "variables": {
      "appName": "OpenModulePlatform.Web.ContentWebAppModule",
      "logDirectory": "${basedir}/logs"
    },
    "targets": {
      "logfile": {
        "type": "File",
        "fileName": "${var:logDirectory}/${var:appName}-${shortdate}.log",
        "layout": "${longdate}|${uppercase:${level}}|${logger}|${message}${onexception:inner= ${exception:format=tostring}}"
      },
      "console": {
        "type": "Console",
        "layout": "${longdate}|${uppercase:${level}}|${logger}|${message}${onexception:inner= ${exception:format=tostring}}"
      }
    },
    "rules": [
      {
        "logger": "Microsoft.Hosting.Lifetime",
        "minLevel": "Info",
        "writeTo": "console,logfile",
        "final": true
      },
      {
        "logger": "Microsoft.*",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "console,logfile"
      }
    ]
  }
}
