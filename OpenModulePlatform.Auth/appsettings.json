// File: OpenModulePlatform.Auth/appsettings.json
{
  "OmpAuth": {
    "CookieName": ".OpenModulePlatform.Auth",
    "LoginPath": "/auth/login",
    "LogoutPath": "/auth/logout",
    "AccessDeniedPath": "/status/403",
    "ApplicationName": "OpenModulePlatform",
    "DataProtectionKeyPath": "",
    "Oidc": {
      "Enabled": false,
      "DisplayName": "OpenID Connect",
      "ProviderName": "OIDC",
      "Authority": "",
      "MetadataAddress": "",
      "ClientId": "",
      "ClientSecret": "",
      "CallbackPath": "/signin-oidc",
      "ResponseType": "code",
      "Scopes": [ "openid", "profile" ],
      "ClaimTypes": {
        "ProviderUserKeyClaimType": "sub",
        "UserIdClaimType": "sub",
        "NameClaimType": "name",
        "DisplayNameClaimType": "name",
        "UserSidClaimType": "",
        "UpnClaimType": "upn",
        "SamAccountNameClaimType": "",
        "DomainClaimType": "",
        "GroupsClaimType": "groups",
        "GroupClaimTypes": [],
        "GroupSidClaimTypes": [],
        "GroupNameClaimTypes": []
      }
    }
  },
  "ConnectionStrings": {
    "OmpDb": "Server=localhost;Database=OpenModulePlatform;Integrated Security=true;TrustServerCertificate=true;"
  },
  "WebApp": {
    "SecurityHeaders": {
      "ContentSecurityPolicy": {
        "//": "The Auth app is the platform's strict-policy reference: after the login page's inline <style>/<script> blocks were moved to wwwroot (login.css / login.js) it needs no unsafe-inline anywhere. Still emitted report-only by default (ReportOnly defaults to true); flip to enforce once the report log is clean. See docs/CONTENT_SECURITY_POLICY.md.",
        "Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'; frame-ancestors 'self'"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "variables": {
      "appName": "OpenModulePlatform.Auth",
      "logDirectory": "${basedir}/logs"
    },
    "targets": {
      "logfile": {
        "type": "File",
        "fileName": "${var:logDirectory}/${var:appName}-${shortdate}.log",
        "layout": "${longdate}|${uppercase:${level}}|${logger}|${message}${onexception:inner= ${exception:format=tostring}}"
      },
      "console": {
        "type": "Console",
        "layout": "${longdate}|${uppercase:${level}}|${logger}|${message}${onexception:inner= ${exception:format=tostring}}"
      }
    },
    "rules": [
      {
        "logger": "Microsoft.Hosting.Lifetime",
        "minLevel": "Info",
        "writeTo": "console,logfile",
        "final": true
      },
      {
        "logger": "Microsoft.*",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "console,logfile"
      }
    ]
  }
}
