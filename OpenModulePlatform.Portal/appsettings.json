// File: OpenModulePlatform.Portal/appsettings.json
{
  "Portal": {
    "Title": "OMP Portal",
    "ModuleKey": "omp_portal",
    "AppKey": "omp_portal",
    "AppInstanceKey": "omp_portal",
    "DefaultCulture": "sv-SE",
    "SupportedCultures": [
      "sv-SE",
      "en-US"
    ],
    "PortalTopBar": {
      "Enabled": true,
      "PortalBaseUrl": "/"
    },
    "TopbarShortcuts": {
      "Enabled": true,
      "AllModules": "m",
      "Favorites": "f"
    },
    "SecurityHeaders": {
      "ContentSecurityPolicy": {
        "//": "Baseline plus the webamp music widget: blob: in img-src (skin sprites unzipped in JS, served via URL.createObjectURL) and media-src (track/album-art blobs); data: cursors come from the vendored bundle. style-src 'unsafe-inline' is still required by webamp's runtime-injected skin <style> element and dynamic Razor style attributes. script-src has no 'unsafe-inline' since the 16 inline blocks moved to wwwroot/js static files (campaign csp-vagen-till-enforcement). See docs/CONTENT_SECURITY_POLICY.md.",
        "Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ws: wss:; media-src 'self' blob:; worker-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'; frame-ancestors 'self'"
      }
    },
    "AllowAnonymous": false,
    "UseForwardedHeaders": false,
    "PermissionMode": "Any"
  },
  "PushEvents": {
    "Producers": {
      "UseOutboxForNotificationStateChanges": true
    },
    "Dispatcher": {
      "Enabled": true
    }
  },
  "ConnectionStrings": {
    "OmpDb": "Server=localhost;Database=OpenModulePlatform;Integrated Security=true;TrustServerCertificate=true;"
  },
  "ArtifactUpload": {
    "ArtifactStoreRoot": "",
    "TempRoot": "",
    "AvailableModuleDefinitionsRoot": "",
    "AvailableArtifactsRoot": "",
    "AvailableHostConfigurationsRoot": "",
    "AvailableConfigOverlaysRoot": "",
    "MaxUploadBytes": 536870912
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "extensions": [
      { "assembly": "NLog.Database" }
    ],
    "variables": {
      "appName": "OpenModulePlatform.Portal",
      "logDirectory": "${basedir}/logs"
    },
    "targets": {
      "systemlog": {
        "type": "AsyncWrapper",
        "overflowAction": "Discard",
        "queueLimit": 2000,
        "target": {
          "type": "Database",
          "dbProvider": "Microsoft.Data.SqlClient.SqlConnection, Microsoft.Data.SqlClient",
          "connectionString": "${configsetting:item=ConnectionStrings.OmpDb}",
          "keepConnection": false,
          "commandText": "INSERT INTO omp.SystemLog (LoggedUtc, HostName, ProcessName, Level, Logger, Message, Exception, CorrelationId) VALUES (@LoggedUtc, @HostName, @ProcessName, @Level, @Logger, @Message, @Exception, @CorrelationId)",
          "parameters": [
            { "name": "@LoggedUtc", "layout": "${date:universalTime=true:format=yyyy-MM-dd HH\\:mm\\:ss.fff}", "dbType": "DbType.DateTime2" },
            { "name": "@HostName", "layout": "${machinename}", "dbType": "DbType.String", "size": 128 },
            { "name": "@ProcessName", "layout": "${var:appName}", "dbType": "DbType.String", "size": 128 },
            { "name": "@Level", "layout": "${level}", "dbType": "DbType.String", "size": 16 },
            { "name": "@Logger", "layout": "${logger}", "dbType": "DbType.String", "size": 256 },
            { "name": "@Message", "layout": "${message}", "dbType": "DbType.String" },
            { "name": "@Exception", "layout": "${exception:format=tostring}", "dbType": "DbType.String", "allowDbNull": true },
            { "name": "@CorrelationId", "layout": "${scopeproperty:item=CorrelationId}", "dbType": "DbType.String", "size": 64, "allowDbNull": true }
          ]
        }
      },
      "logfile": {
        "type": "File",
        "fileName": "${var:logDirectory}/${var:appName}-${shortdate}.log",
        "maxArchiveDays": 14,
        "layout": "${longdate}|${uppercase:${level}}|${logger}|${scopeproperty:item=CorrelationId}|${message}${onexception:inner= ${exception:format=tostring}}"
      },
      "console": {
        "type": "Console",
        "layout": "${longdate}|${uppercase:${level}}|${logger}|${scopeproperty:item=CorrelationId}|${message}${onexception:inner= ${exception:format=tostring}}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Warn",
        "writeTo": "systemlog"
      },
      {
        "logger": "Microsoft.Hosting.Lifetime",
        "minLevel": "Info",
        "writeTo": "console,logfile",
        "final": true
      },
      {
        "logger": "Microsoft.*",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "console,logfile"
      }
    ]
  }
}
