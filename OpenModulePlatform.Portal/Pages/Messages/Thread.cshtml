@page "/messages/{conversationId:long}"
@model OpenModulePlatform.Portal.Pages.Messages.ThreadModel
@{
    var restoreScrollTop = ViewContext.HttpContext.Request.Query["restoreScrollTop"].ToString();
}

@if (!Model.CanUseMessages)
{
    <section class="page-header">
        <div>
            <div class="eyebrow">@L["Messages"]</div>
            <h2>@L["Conversation"]</h2>
        </div>
    </section>
    <section class="card top-gap">
        <div class="empty-state">@(Model.MessagesDisabled ? L["Messages are disabled"].Value : L["Messages require an OMP user"].Value)</div>
    </section>
}
else if (Model.Conversation is null)
{
    <section class="page-header">
        <div>
            <div class="eyebrow">@L["Messages"]</div>
            <h2>@L["Conversation"]</h2>
        </div>
        <div class="toolbar">
            <a class="action-link" asp-page="/Messages/Index">@L["Messages"]</a>
        </div>
    </section>
    <section class="card top-gap">
        <div class="empty-state">@L["This conversation was not found."]</div>
    </section>
}
else
{
    @* Feedback from a removal ("X was removed from the group") or a refused
       change; the thread's own validation summary lives inside the scroll area. *@
    @await Component.InvokeAsync("OmpFeedback", new { message = Model.StatusMessage, includeValidationSummary = false })
    <section class="portal-message-thread-layout top-gap">
        <aside class="portal-message-thread__side portal-message-thread__side--identity">
            <div class="eyebrow">@L["Messages"]</div>
            <h2>@Model.Conversation.DisplayTitle</h2>
            @if (Model.Conversation.IsGroup)
            {
                @* The group's members, earliest joined first. The creator is the
                   admin and the only one who can remove others; everyone can leave. *@
                <ul class="portal-message-thread__participants" aria-label="@L["Participants"]">
                    @foreach (var participant in Model.Conversation.Participants)
                    {
                        <li class="portal-message-thread__participant">
                            <span class="portal-message-thread__participant-name">@participant.DisplayName</span>
                            @if (participant.IsAdmin)
                            {
                                <span class="pill portal-message-thread__participant-admin">@L["Group admin"]</span>
                            }
                            @if (Model.IsGroupAdmin && participant.UserId != Model.CurrentUserId)
                            {
                                <form method="post"
                                      asp-page-handler="RemoveParticipant"
                                      asp-route-conversationId="@Model.Conversation.ConversationId"
                                      asp-route-userId="@participant.UserId"
                                      class="portal-message-thread__participant-remove"
                                      data-enhance="false">
                                    <button type="submit"
                                            class="portal-message-thread__participant-remove-button"
                                            title="@L["Remove from group"]"
                                            aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, L["Remove {0} from the group"].Value, participant.DisplayName)"
                                            data-confirm="@string.Format(System.Globalization.CultureInfo.CurrentCulture, L["Remove {0} from the group?"].Value, participant.DisplayName)"></button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            }
            else if (!string.IsNullOrWhiteSpace(Model.Conversation.ParticipantNames))
            {
                <p>@Model.Conversation.ParticipantNames</p>
            }
        </aside>

        <section class="card portal-message-thread">
            <div class="portal-message-thread__scroll"
                 data-message-thread-scroll
                 data-restore-scroll-top="@restoreScrollTop"
                 data-live-disabled="@(Model.IsHistoryView ? "true" : "false")">
                <div asp-validation-summary="All" class="portal-message-thread__error-banner"></div>
                <partial name="_ThreadMessages" model="Model" />
                <span class="visually-hidden" role="status" aria-live="polite" data-message-thread-status></span>
            </div>

            <form method="post"
                  enctype="multipart/form-data"
                  asp-page-handler="Send"
                  asp-route-conversationId="@Model.Conversation.ConversationId"
                  class="portal-message-thread__composer"
                  data-message-thread-composer
                  data-conversation-id="@Model.Conversation.ConversationId"
                  data-refresh-url="@Url.Page("/Messages/Thread", "Messages", new { conversationId = Model.Conversation.ConversationId })"
                  data-updated-text="@L["Conversation updated"]"
                  data-send-error-text="@L["The message could not be sent."]"
                  data-delete-error-text="@L["The message could not be deleted."]"
                  data-edit-url-template="@Url.Page("/Messages/Thread", "Edit", new { conversationId = Model.Conversation.ConversationId, messageId = 0 })"
                  data-removed-url="@Url.Page("/Messages/Index")"
                  data-enhance="false">
                <input asp-for="RestoreScrollTop" type="hidden" data-message-thread-scroll-input />
                @* Edit mode: the composer rewrites one of the sender's own messages.
                   The page script fills the field, points the form at the Edit
                   handler and shows this strip with a way out. *@
                <div class="portal-message-thread__editing" data-message-thread-editing hidden>
                    <span>@L["Editing message"]</span>
                    <button type="button" class="btn btn-secondary btn-sm" data-message-thread-edit-cancel>@L["Cancel"]</button>
                </div>
                @* Files picked or pasted wait here, each with a thumbnail, its name and
                   a remove button, until the message is sent. Filled by the page script. *@
                <div class="portal-message-thread__pending" data-message-thread-pending data-remove-text="@L["Remove"]" hidden></div>
                <div class="portal-message-thread__composer-row">
                    <label class="portal-message-thread__message-field">
                        <span class="visually-hidden">@L["Message"]</span>
                        <input asp-for="MessageContent" type="text" placeholder="@L["Type a message"]" autocomplete="off" />
                    </label>
                    <label class="portal-message-thread__composer-button portal-message-thread__composer-button--attach"
                           title="@L["Attach file"]"
                           aria-label="@L["Attach file"]">
                        <input asp-for="Attachments" type="file" multiple />
                        <span class="portal-message-thread__composer-icon portal-message-thread__composer-icon--attach" aria-hidden="true"></span>
                        <span class="visually-hidden">@L["Attach file"]</span>
                    </label>
                    <button type="submit"
                            class="portal-message-thread__composer-button portal-message-thread__composer-button--send"
                            title="@L["Send"]"
                            aria-label="@L["Send"]">
                        <span class="portal-message-thread__composer-icon portal-message-thread__composer-icon--send" aria-hidden="true"></span>
                        <span class="visually-hidden">@L["Send"]</span>
                    </button>
                </div>
            </form>
        </section>

        <aside class="portal-message-thread__side portal-message-thread__side--actions">
            <div class="toolbar">
                <a class="action-link" asp-page="/Messages/Index">@L["Messages"]</a>
                <a class="action-link" asp-page="/Messages/New">@L["New conversation"]</a>
                @if (Model.Conversation.IsGroup)
                {
                    <form method="post"
                          asp-page-handler="Leave"
                          asp-route-conversationId="@Model.Conversation.ConversationId"
                          data-enhance="false">
                        <button type="submit" class="btn btn-danger btn-sm" data-confirm="@L["Leave this group?"]">@L["Leave group"]</button>
                    </form>
                }
            </div>
        </aside>
    </section>
}

@section Scripts {
    <script src="~/js/message-thread-page.js"></script>
}
