@model OpenModulePlatform.Portal.Pages.Messages.ThreadModel
@using OpenModulePlatform.Web.Shared.Web
@{
    bool IsGroupConversation()
        => string.Equals(Model.Conversation?.ConversationType, "group", StringComparison.OrdinalIgnoreCase);

    string SenderBubbleStyle(OpenModulePlatform.Web.Shared.Services.MessageRow message)
    {
        if (message.IsOwnMessage || !IsGroupConversation())
        {
            return string.Empty;
        }

        var palette = new (string Background, string Border)[]
        {
            ("#fef3c7", "#f59e0b"),
            ("#ede9fe", "#8b5cf6"),
            ("#dcfce7", "#22c55e"),
            ("#fee2e2", "#ef4444"),
            ("#cffafe", "#06b6d4"),
            ("#fce7f3", "#ec4899")
        };
        var senderColorIndex = (int)(Math.Abs((long)message.SenderUserId) % palette.Length);
        var color = palette[senderColorIndex];
        return $"--portal-message-sender-bg: {color.Background}; --portal-message-sender-border: {color.Border};";
    }
}

<div data-message-thread-content
     data-latest-message-id="@Model.LatestMessageId">
    @if (Model.HasMoreMessages && Model.Rows.Count > 0)
    {
        <a class="portal-message-thread__older"
           asp-page="/Messages/Thread"
           asp-route-conversationId="@Model.Conversation?.ConversationId"
           asp-route-beforeMessageId="@Model.Rows[0].MessageId">@L["Load older messages"]</a>
    }

    @if (Model.Rows.Count == 0)
    {
        <div class="empty-state">@L["No messages"]</div>
    }
    else
    {
        <div class="portal-message-thread__messages">
            @foreach (var message in Model.Rows)
            {
                if (message.IsSystem)
                {
                    @* What happened in the group, told as "<name> <predicate>": the
                       sender is the participant the line is about. *@
                    <div class="portal-message-thread__system" data-message-id="@message.MessageId">
                        <span>@message.SenderDisplayName @message.Content</span>
                        <time>@message.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.CurrentCulture)</time>
                    </div>
                    continue;
                }

                var avatarUrl = OmpAvatarHelper.BuildUserAvatarPath(message.SenderUserId, message.SenderProfileImageStorageKey);
                var avatarInitials = OmpAvatarHelper.GetInitials(message.SenderDisplayName);
                <article class="portal-message-thread__message@(message.IsOwnMessage ? " is-own" : string.Empty)@(message.IsDeleted ? " is-deleted" : string.Empty)"
                         style="@SenderBubbleStyle(message)"
                         data-message-id="@message.MessageId">
                    @if (!message.IsOwnMessage)
                    {
                        <span class="portal-message-thread__avatar" aria-hidden="true">
                            @if (!string.IsNullOrWhiteSpace(avatarUrl))
                            {
                                <img src="@avatarUrl" alt="" />
                            }
                            else
                            {
                                @avatarInitials
                            }
                        </span>
                    }
                    <div class="portal-message-thread__bubble">
                        <div class="portal-message-thread__meta">
                            <strong>@message.SenderDisplayName</strong>
                            <span>@message.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.CurrentCulture)</span>
                            @if (!message.IsDeleted && message.EditedAt is { } editedAt)
                            {
                                <span class="portal-message-thread__edited" title="@editedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.CurrentCulture)">@L["Edited"]</span>
                            }
                            @if (message.CanEdit)
                            {
                                <button type="button"
                                        class="portal-message-thread__edit"
                                        title="@L["Edit message"]"
                                        aria-label="@L["Edit message"]"
                                        data-message-edit="@message.MessageId"
                                        data-message-content="@message.Content"></button>
                            }
                            @if (message.CanDelete)
                            {
                                @* A plain form, so deleting works in the history view too; the
                                   live page intercepts it and swaps the list without a reload. *@
                                <form method="post"
                                      asp-page-handler="Delete"
                                      asp-route-conversationId="@Model.Conversation?.ConversationId"
                                      asp-route-messageId="@message.MessageId"
                                      class="portal-message-thread__delete-form"
                                      data-message-delete="@message.MessageId"
                                      data-enhance="false">
                                    <button type="submit"
                                            class="portal-message-thread__delete"
                                            title="@L["Delete message"]"
                                            aria-label="@L["Delete message"]"
                                            data-confirm="@L["Delete this message?"]"></button>
                                </form>
                            }
                        </div>
                        @if (message.IsDeleted)
                        {
                            @* Not text anyone wrote: an icon, italics and a muted dashed bubble
                               (see the CSS) tell it apart from a message that says "deleted". *@
                            <p class="portal-message-thread__deleted"
                               title="@message.DeletedAt!.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.CurrentCulture)">
                                <span class="portal-message-thread__deleted-icon" aria-hidden="true"></span>
                                @L["This message was deleted"]
                            </p>
                        }
                        else if (!string.IsNullOrWhiteSpace(message.Content))
                        {
                            <p>@message.Content</p>
                        }
                        @if (message.Attachments.Count > 0)
                        {
                            <div class="portal-message-thread__attachments">
                                @foreach (var attachment in message.Attachments)
                                {
                                    <a class="portal-message-thread__attachment" href="@attachment.DownloadUrl" data-enhance-nav="false">
                                        @if (attachment.IsImage)
                                        {
                                            <img src="@attachment.DownloadUrl" alt="@attachment.FileName" loading="lazy" />
                                        }
                                        <span>@attachment.FileName</span>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                    @if (message.IsOwnMessage)
                    {
                        <span class="portal-message-thread__avatar" aria-hidden="true">
                            @if (!string.IsNullOrWhiteSpace(avatarUrl))
                            {
                                <img src="@avatarUrl" alt="" />
                            }
                            else
                            {
                                @avatarInitials
                            }
                        </span>
                    }
                </article>
            }
        </div>
    }
</div>
