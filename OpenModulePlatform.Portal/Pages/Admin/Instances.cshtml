@page
@model OpenModulePlatform.Portal.Pages.Admin.InstancesModel
@{
    var ompBranding = await OmpBrandingService.GetBrandingAsync(ViewContext.HttpContext.RequestAborted);
}

<section class="page-header">
    <div>
        <div class="eyebrow">@L["Manual core"]</div>
        <h2>@L["Instances"]</h2>
        <p class="lede">@ompBranding.ApplyPlatformName(L["The current Portal workflow treats one OMP database/runtime set as one installation. Use System > Installation for desired topology changes."].Value)</p>
    </div>
</section>

<div class="toolbar top-gap">
    <a class="action-link" href="~/admin/instanceedit">@L["Create instance"]</a>
</div>

@if (Model.Rows.Count == 0)
{
    <div class="empty-state">@L["No instances found."]</div>
}
else
{
    <div class="toolbar top-gap">
        <details class="list-filter" data-list-filter="instances-list">
            <summary class="btn btn-ghost">@L["Filter"]<span class="list-filter__count" data-filter-count hidden></span></summary>
            <div class="list-filter__menu">
                <fieldset class="list-filter__group" data-filter-group="enabled">
                    <legend>@L["Enabled"]</legend>
                    <label class="list-filter__option"><input type="checkbox" data-filter-column="3" data-filter-equals="1" /> @L["Enabled"]</label>
                    <label class="list-filter__option"><input type="checkbox" data-filter-column="3" data-filter-equals="0" /> @L["Disabled"]</label>
                </fieldset>
                <button type="button" class="btn btn-ghost btn-sm" data-filter-clear>@L["Clear filters"]</button>
            </div>
        </details>
        <input type="search" class="list-search" data-list-search="instances-list" placeholder="@L["Search rows"]" aria-label="@L["Search rows"]" />
        <span class="list-count" data-list-count="instances-list" data-template="@L["Showing {0} of {1} rows."]"></span>
    </div>
    <div class="empty-state" data-list-empty="instances-list" hidden>@L["No rows match the current filters."]</div>
    <table id="instances-list" class="grid sortable-list" data-sortable-list data-page-size="50">
        <thead>
            <tr>
                <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Instance key"]</button></th>
                <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Display name"]</button></th>
                <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Installation profile"]</button></th>
                <th scope="col" data-sort-type="number"><button type="button" class="sortable-list__button">@L["Enabled"]</button></th>
                <th scope="col">@L["Actions"]</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td><code>@row.InstanceKey</code></td>
                <td>@row.DisplayName</td>
                <td>@row.InstanceTemplateKey</td>
                <td data-sort-value="@(row.IsEnabled ? 1 : 0)"><span class="pill">@(row.IsEnabled ? L["Enabled"] : L["Disabled"])</span></td>
                <td><a class="action-link" href="~/admin/instanceedit?id=@row.InstanceId">@L["Edit"]</a></td>
            </tr>
        }
        </tbody>
    </table>
    <div class="list-show-more">
        <button type="button" class="btn btn-secondary btn-sm" data-list-show-more="instances-list" hidden>@L["Show more"]</button>
    </div>
}
