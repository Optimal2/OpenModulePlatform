@page
@model OpenModulePlatform.Portal.Pages.Admin.ModuleInstancesModel
@{
    var ompBranding = await OmpBrandingService.GetBrandingAsync(ViewContext.HttpContext.RequestAborted);
}

<section class="page-header">
    <div>
        <div class="eyebrow">@L["Manual core"]</div>
        <h2>@L["Module instances"]</h2>
        <p class="lede">@ompBranding.ApplyPlatformName(L["Module instances bind module definitions into a specific OMP instance. This is the operational layer above definitions and below app instances."].Value)</p>
    </div>
</section>

<div class="toolbar top-gap">
    <a class="action-link" href="~/admin/moduleinstanceedit">@L["Create module instance"]</a>
</div>

@if (Model.Rows.Count == 0)
{
    <div class="empty-state">@L["No module instances found."]</div>
}
else
{
    <div class="toolbar top-gap">
        <details class="list-filter" data-list-filter="module-instances-list">
            <summary class="btn btn-ghost">@L["Filter"]<span class="list-filter__count" data-filter-count hidden></span></summary>
            <div class="list-filter__menu">
                <fieldset class="list-filter__group" data-filter-group="enabled">
                    <legend>@L["Enabled"]</legend>
                    <label class="list-filter__option"><input type="checkbox" data-filter-column="4" data-filter-equals="1" /> @L["Enabled"]</label>
                    <label class="list-filter__option"><input type="checkbox" data-filter-column="4" data-filter-equals="0" /> @L["Disabled"]</label>
                </fieldset>
                <button type="button" class="btn btn-ghost btn-sm" data-filter-clear>@L["Clear filters"]</button>
            </div>
        </details>
        <input type="search" class="list-search" data-list-search="module-instances-list" placeholder="@L["Search rows"]" aria-label="@L["Search rows"]" />
        <span class="list-count" data-list-count="module-instances-list" data-template="@L["Showing {0} of {1} rows."]"></span>
    </div>
    <div class="empty-state" data-list-empty="module-instances-list" hidden>@L["No rows match the current filters."]</div>
    <table id="module-instances-list" class="grid sortable-list" data-sortable-list data-page-size="50">
        <thead>
            <tr>
                <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Instance"]</button></th>
                <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Module"]</button></th>
                <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Module instance key"]</button></th>
                <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Display name"]</button></th>
                <th scope="col" data-sort-type="number"><button type="button" class="sortable-list__button">@L["Enabled"]</button></th>
                <th scope="col">@L["Actions"]</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td><code>@row.InstanceKey</code></td>
                <td><code>@row.ModuleKey</code></td>
                <td><code>@row.ModuleInstanceKey</code></td>
                <td>@row.DisplayName</td>
                <td data-sort-value="@(row.IsEnabled ? 1 : 0)"><span class="pill">@(row.IsEnabled ? L["Enabled"] : L["Disabled"])</span></td>
                <td class="admin-action-cell">
                    <a class="action-link admin-icon-button admin-icon-button--edit"
                       href="~/admin/moduleinstanceedit?id=@row.ModuleInstanceId"
                       title="@L["Edit"]"
                       aria-label="@L["Edit"]">
                        <span class="visually-hidden">@L["Edit"]</span>
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <div class="list-show-more">
        <button type="button" class="btn btn-secondary btn-sm" data-list-show-more="module-instances-list" hidden>@L["Show more"]</button>
    </div>
}
