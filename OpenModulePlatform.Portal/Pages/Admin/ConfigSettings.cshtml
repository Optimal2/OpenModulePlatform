@page
@model OpenModulePlatform.Portal.Pages.Admin.ConfigSettingsModel
@using OpenModulePlatform.Web.Shared.Models
@using OpenModulePlatform.Web.Shared.Navigation

@{
    const string StatusSectionId = "config-settings-status";
    const string EditorSectionId = "config-settings-editor";
    const string ValuesSectionId = "config-settings-values";

    var editorTitle = Model.IsEdit ? L["Edit config setting value"].Value : L["Add config setting value"].Value;

    var pageHeader = new PageHeaderModel
    {
        Eyebrow = L["System"].Value,
        Title = L["Config settings"].Value,
        Info = L["Manage installation-specific values for config settings registered by OMP upgrades. The allowed setting list is controlled by the platform schema and is not edited here."].Value,
        CssClass = "config-settings-page-header"
    };

    var sectionNavigatorItems = new List<SectionNavigatorItem>();
    if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        sectionNavigatorItems.Add(new SectionNavigatorItem(L["Status"].Value, StatusSectionId));
    }

    sectionNavigatorItems.Add(new SectionNavigatorItem(editorTitle, EditorSectionId));
    sectionNavigatorItems.Add(new SectionNavigatorItem(L["Configured values"].Value, ValuesSectionId));

    var sectionNavigator = new SectionNavigatorModel
    {
        Label = L["Page sections"].Value,
        RootText = L["Config settings"].Value,
        Items = sectionNavigatorItems
    };
}

<div class="section-navigator-layout">
    <div class="section-navigator-layout__header">
        <partial name="_PageHeader" model="pageHeader" />
    </div>

    @await Component.InvokeAsync("SectionNavigator", new { model = sectionNavigator })
    <div class="section-navigator-layout__content">

<div id="@StatusSectionId" class="section-navigator-target">
    @await Component.InvokeAsync("OmpFeedback", new { message = Model.StatusMessage })
</div>

@{
    var configSettingsPicker = new ColumnListPickerModel
    {
        Title = Model.IsEdit ? L["Edit config setting value"].Value : L["Add config setting value"].Value,
        ListLabel = L["Select setting"].Value,
        DetailsLabel = L["Config settings"].Value,
        ListPartialName = "~/Pages/Admin/_ConfigSettingsSettingList.cshtml",
        ListModel = Model,
        DetailsPartialName = "~/Pages/Admin/_ConfigSettingsSettingDetails.cshtml",
        DetailsModel = Model,
        FooterPartialName = "~/Pages/Admin/_ConfigSettingsFormActions.cshtml",
        FooterModel = Model,
        CssClass = "config-settings-picker"
    };
}

<form id="@EditorSectionId"
      method="post"
      class="config-settings-form section-navigator-target"
      data-config-settings-form
      data-no-description-label="@L["No description available"]"
      data-example-values-label="@L["Example values:"]"
      data-no-examples-label="@L["No examples available."]"
      data-use-example-label="@L["Use example value"]">
    <input type="hidden" asp-for="Input.ConfigId" />

    @await Component.InvokeAsync("ColumnListPicker", configSettingsPicker)
</form>

<section id="@ValuesSectionId" class="top-gap section-navigator-target">
    <h3>@L["Configured values"]</h3>

    @if (Model.Rows.Count == 0)
    {
        <div class="card empty-state">@L["No config setting values have been configured yet."]</div>
    }
    else
    {
        <div class="toolbar">
            <details class="list-filter" data-list-filter="config-values-list">
                <summary class="btn btn-ghost">@L["Filter"]<span class="list-filter__count" data-filter-count hidden></span></summary>
                <div class="list-filter__menu">
                    <fieldset class="list-filter__group" data-filter-group="scope">
                        <legend>@L["Scope"]</legend>
                        <label class="list-filter__option"><input type="checkbox" data-filter-column="1" data-filter-equals="global" /> @L["Global"]</label>
                        <label class="list-filter__option"><input type="checkbox" data-filter-column="1" data-filter-equals="user" /> @L["User"]</label>
                        <label class="list-filter__option"><input type="checkbox" data-filter-column="1" data-filter-equals="role" /> @L["Role"]</label>
                        <label class="list-filter__option"><input type="checkbox" data-filter-column="1" data-filter-equals="permission" /> @L["Permission"]</label>
                    </fieldset>
                    <button type="button" class="btn btn-ghost btn-sm" data-filter-clear>@L["Clear filters"]</button>
                </div>
            </details>
            <input type="search" class="list-search" data-list-search="config-values-list" placeholder="@L["Search rows"]" aria-label="@L["Search rows"]" />
            <span class="list-count" data-list-count="config-values-list" data-template="@L["Showing {0} of {1} rows."]"></span>
        </div>
        <div class="empty-state" data-list-empty="config-values-list" hidden>@L["No rows match the current filters."]</div>
        <div class="table-scroll">
        <table id="config-values-list" class="grid sortable-list" data-sortable-list>
            <thead>
                <tr>
                    <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Setting"]</button></th>
                    <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Scope"]</button></th>
                    <th scope="col" data-sort-type="number"><button type="button" class="sortable-list__button">@L["Priority"]</button></th>
                    <th scope="col">@L["Value"]</th>
                    <th scope="col">@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td data-sort-value="@row.Key">
                            <code>@row.Key</code>
                            @if (!row.IsDefinitionEnabled)
                            {
                                <div class="muted">@L["Definition disabled"]</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(row.Description))
                            {
                                <div class="list-message muted">@row.Description</div>
                            }
                        </td>
                        <td data-sort-value="@Model.ScopeKey(row)">
                            <span class="pill">@Model.ScopeText(row)</span>
                            <div class="muted">@Model.ScopeTargetText(row)</div>
                        </td>
                        <td>@row.ConfigPriority</td>
                        @* The FULL value goes into the DOM: the list-message
                           truncates it to one line visually, and the click
                           popover then shows everything - a server-side
                           preview here would cap what the popover can show. *@
                        <td class="config-value-cell">
                            @if (row.ConfigValue is null)
                            {
                                <span class="muted">@L["NULL"]</span>
                            }
                            else
                            {
                                <span class="list-message"><code>@row.ConfigValue</code></span>
                            }
                        </td>
                        <td>
                            <div class="admin-icon-actions">
                                <a class="action-link admin-icon-button admin-icon-button--edit"
                                   href="~/admin/configsettings?configId=@row.ConfigId"
                                   title="@L["Edit"]"
                                   aria-label="@L["Edit"]">
                                    <span class="visually-hidden">@L["Edit"]</span>
                                </a>
                                <form
                                    method="post"
                                    asp-page-handler="Delete"
                                    asp-route-configId="@row.ConfigId"
                                    data-omp-confirm="@L["Delete this config setting value?"]"
                                    data-omp-confirm-ok="@L["Delete"]"
                                    data-omp-confirm-cancel="@L["Cancel"]">
                                    <button type="submit"
                                            class="btn btn-danger admin-icon-button admin-icon-button--delete"
                                            title="@L["Delete"]"
                                            aria-label="@L["Delete"]">
                                        <span class="visually-hidden">@L["Delete"]</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</section>

    </div>
</div>

@section Scripts {
    <script src="~/js/admin-config-settings.js"></script>
}
