@page "/admin/configoverlays"
@model OpenModulePlatform.Portal.Pages.Admin.ConfigOverlaysModel

<section class="page-header">
    <div>
        <div class="eyebrow">@L["System"]</div>
        <h2>@L["Configuration overlays"]</h2>
        <p class="lede">@L["This installation is the connected Portal database. All hosts means every host in this installation, including future hosts, stored as one overlay. It does not target another installation."]</p>
    </div>
</section>
<div class="toolbar">
    <a class="action-link" href="~/admin/instancetemplateedit?id=1">@L["Installation"]</a>
    <a class="action-link" href="~/admin/hosts">@L["Hosts"]</a>
    <a class="action-link" href="~/admin/modulepackageimport">@L["Import/export"]</a>
</div>
@await Component.InvokeAsync("OmpFeedback", new { message = Model.StatusMessage, includeValidationSummary = true })
@if (Model.Snapshot.Hosts.GroupBy(h => h.HostKey, StringComparer.OrdinalIgnoreCase).Any(g => g.Count() > 1))
{
    <p role="alert">@L["Duplicate host keys exist across instance rows. Overlay identity uses the host key alone. Resolve duplicate host keys before exact-host editing or effective readback; existing runtime matching is unchanged."]</p>
}
@if (!Model.Snapshot.SchemaReady)
{
    <div class="empty-state" role="alert">@L["Schema not ready. Upgrade the platform schema before editing. Missing HostScope uses exact-host fallback; existing rows remain readable."]</div>
}
<section class="card top-gap">
    <h3>@L["Saved overlays"]</h3>
    <form method="get" autocomplete="off">
        @if (Model.Detail is not null)
        {
            <input type="hidden" name="id" value="@Model.Detail.Summary.ConfigOverlayDocumentId" />
        }
        <label>@L["Host"]
            <select asp-for="FilterHost">
                <option value="">@L["All"]</option>
                @foreach (var host in Model.Snapshot.Hosts) { <option value="@host.HostKey">@host.HostKey</option> }
            </select>
        </label>
        <label>@L["Module"]<input asp-for="FilterModule" /></label>
        <label>@L["App"]<input asp-for="FilterApp" /></label>
        <label>@L["Package type"]<input asp-for="FilterPackage" /></label>
        <label>@L["Target"]<input asp-for="FilterTarget" /></label>
        <label>@L["State"]
            <select asp-for="FilterEnabled">
                <option value="">@L["All"]</option>
                <option value="enabled">@L["Enabled"]</option>
                <option value="disabled">@L["Disabled"]</option>
            </select>
        </label>
        <label>@L["Scope"]
            <select asp-for="FilterScope">
                <option value="">@L["All"]</option>
                <option value="Host">@L["One exact host"]</option>
                <option value="AllHosts">@L["All hosts in this installation"]</option>
            </select>
        </label>
        <button type="submit">@L["Filter"]</button>
        <a asp-page="/Admin/ConfigOverlays">@L["Clear filters"]</a>
    </form>
    @if (Model.FilteredOverlays.Count == 0)
    {
        <p>@L[Model.Snapshot.Overlays.Count == 0 ? "No saved overlays in this installation." : "No rows match the current filters."]</p>
    }
    else
    {
        <table class="grid">
            <thead><tr><th>@L["Overlay"]</th><th>@L["Scope"]</th><th>@L["Selectors"]</th><th>@L["Origin"]</th><th>@L["Files"]</th><th>@L["State"]</th><th>@L["Actions"]</th></tr></thead>
            <tbody>
            @foreach (var row in Model.FilteredOverlays)
            {
                <tr>
                    <td><a asp-page="/Admin/ConfigOverlays" asp-route-id="@row.ConfigOverlayDocumentId">@row.OverlayKey @row.OverlayVersion</a></td>
                    <td>
                        @(row.HostScope == "AllHosts" ? L["All hosts in this installation"].Value : row.HostKey)
                        @if (row.HostScope != "AllHosts" && !Model.Snapshot.Hosts.Any(h => string.Equals(h.HostKey, row.HostKey, StringComparison.OrdinalIgnoreCase)))
                        { <span class="pill">@L["Host missing from this installation"]</span> }
                    </td>
                    <td>@row.ModuleKey / @row.AppKey / @row.PackageType / @row.TargetName / @L["Minimum artifact version"]: @row.ArtifactVersion</td>
                    <td>@row.SourceName</td>
                    <td>
                        @if (Model.FileSummariesByDocument.TryGetValue(row.ConfigOverlayDocumentId, out var files) && files.Count > 0)
                        {
                            <ul>
                            @foreach (var file in files)
                            {
                                <li>@file.RelativePath — @(file.IsEnabled ? L["Enabled"] : L["Disabled"]) — @OpenModulePlatform.Portal.Services.ConfigOverlayAdministration.Mode(file.MergeMode, file.RelativePath)</li>
                            }
                            </ul>
                        }
                        else
                        {
                            @row.ConfigurationFileCount
                        }
                    </td>
                    <td>@(row.IsEnabled ? L["Enabled"] : L["Disabled"])</td>
                    <td>
                        <form method="post" data-omp-confirm="@L["Change this saved overlay? Enabling disables other versions of the same key and scope. Delete removes the document and its files. No other version is automatically selected after disable or delete."]">
                            <input type="hidden" name="id" value="@row.ConfigOverlayDocumentId" />
                            <input type="hidden" name="token" value="@ConfigOverlaysModel.Token(row)" />
                            @if (!row.IsEnabled)
                            {
                                <button asp-page-handler="Enable" disabled="@(!Model.Snapshot.SchemaReady)">@L["Enable"]</button>
                            }
                            <a class="action-link" asp-page="/Admin/ConfigOverlays" asp-route-id="@row.ConfigOverlayDocumentId">@L["Preview removal"]</a>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>
<section class="card top-gap">
    <h3>@L["Deleted overlays"]</h3>
    @if (Model.DeletedHistory.Count == 0)
    {
        <p>@L["No deleted overlays recorded."]</p>
    }
    else
    {
        <table class="grid">
            <thead><tr><th>@L["Overlay"]</th><th>@L["Scope"]</th><th>@L["Selectors"]</th><th>@L["Files"]</th><th>@L["Deleted by"]</th><th>@L["Deleted at"]</th></tr></thead>
            <tbody>
            @foreach (var row in Model.DeletedHistory)
            {
                <tr>
                    <td>@row.OverlayKey @row.OverlayVersion</td>
                    <td>@(row.HostScope == "AllHosts" ? L["All hosts in this installation"].Value : row.HostKey)</td>
                    <td>@row.ModuleKey / @row.AppKey / @row.PackageType / @row.TargetName / @L["Minimum artifact version"]: @row.ArtifactVersion</td>
                    <td>@row.ConfigurationFileCount</td>
                    <td>@row.DeletedBy</td>
                    <td>@row.DeletedUtc</td>
                </tr>
            }
            </tbody>
        </table>
        <p>@L["Deleted overlays are historical records only. They are never applicable overlays and never editable live documents."]</p>
    }
</section>
<section class="card top-gap">
    <h3>@(Model.Draft.Id.HasValue ? L["Edit saved overlay draft"] : L["Add overlay draft"])</h3>
    <p>@L["Saving persists configuration for a future deployment; it never writes live files. Editing preserves enabled state and disabled file paths. New versions follow import version selection. Scope, key and version are immutable during edit."]</p>
    <p>@L["Choose scope and host below; these controls set hostScope and hostKey in JSON. Keep module/app/package/target selectors and moduleDefinitionVersion as needed. artifactVersion is a minimum, not an exact version. Files must use inline fileContent and safe relative deployment paths; filesystem references are unavailable."]</p>
    <form method="post" asp-page-handler="Save" autocomplete="off" enctype="multipart/form-data">
        <input type="hidden" asp-for="Draft.Id" />
        <input type="hidden" asp-for="Draft.Token" />
        <div class="form-field">
            <label asp-for="Draft.Scope">@L["Scope"]</label>
            <select asp-for="Draft.Scope">
                <option value="Host">@L["One exact host"]</option>
                <option value="AllHosts">@L["All hosts in this installation"]</option>
            </select>
        </div>
        <div class="form-field">
            <label asp-for="Draft.HostKey">@L["Host (used only for exact-host scope)"]</label>
            <select asp-for="Draft.HostKey">
                <option value="">@L["Select host"]</option>
                @foreach (var host in Model.Snapshot.Hosts) { <option value="@host.HostKey">@host.HostKey (@host.InstanceKey)</option> }
            </select>
        </div>
        <div class="form-field">
            <label asp-for="Draft.Json">@L["Overlay JSON draft (may contain secrets)"]</label>
            <textarea asp-for="Draft.Json" rows="18" spellcheck="false" autocomplete="off"></textarea>
            <span asp-validation-for="Draft.Json"></span>
        </div>
        @if (Model.Detail is not null)
        {
            <ul>
            @foreach (var file in Model.Detail.Files)
            {
                <li>@file.RelativePath — @(file.IsEnabled ? L["Enabled"] : L["Disabled"]) — @OpenModulePlatform.Portal.Services.ConfigOverlayAdministration.Mode(file.MergeMode, file.RelativePath)</li>
            }
            </ul>
        }
        <div class="form-field">
            <label asp-for="DraftFileRelativePath">@L["Relative path"]</label>
            <input asp-for="DraftFileRelativePath" />
            <span asp-validation-for="DraftFileRelativePath"></span>
        </div>
        <div class="form-field">
            <label asp-for="UploadedFile">@L["Upload configuration file"]</label>
            <input asp-for="UploadedFile" type="file" accept=".txt,.json,.config,.xml,.yaml,.yml,.ini,.zip,application/zip" />
            <span asp-validation-for="UploadedFile"></span>
        </div>
        <button asp-page-handler="UploadFile" disabled="@(!Model.Snapshot.SchemaReady)">@L["Upload file content"]</button>
        <p>@L["Upload a text file or a zip file containing exactly one text file. Zip upload is useful when request filters block script-like text content."]</p>
        <button type="submit" disabled="@(!Model.Snapshot.SchemaReady)">@L["Save overlay"]</button>
        <a asp-page="/Admin/ConfigOverlays">@L["New overlay / discard draft"]</a>
    </form>
</section>
<section class="card top-gap">
    <h3>@L["Saved effective sources"]</h3>
    <p>@L["This readback uses saved rows, never the unsaved draft. Precedence: artifact → AllHosts → exact host. The highest version wins within a scope, then update time and file row ID. Merge retains earlier inputs; replace discards them. This is overlay provenance, not live file contents or final deployment configuration (connection protection and other runtime transformations apply later)."]</p>
    <form method="get">
        @if (Model.Detail is not null)
        {
            <input type="hidden" name="id" value="@Model.Detail.Summary.ConfigOverlayDocumentId" />
        }
        <label asp-for="HostKey">@L["Host"]</label>
        <select asp-for="HostKey">
            <option value="">@L["Select host"]</option>
            @foreach (var host in Model.Snapshot.Hosts) { <option value="@host.HostKey">@host.HostKey</option> }
        </select>
        <label asp-for="ArtifactId">@L["Artifact"]</label>
        <select asp-for="ArtifactId">
            <option value="">@L["Select artifact"]</option>
            @foreach (var artifact in Model.Snapshot.Artifacts) { <option value="@artifact.ArtifactId">@artifact.ModuleKey / @artifact.AppKey / @artifact.PackageType / @artifact.TargetName / @artifact.Version</option> }
        </select>
        <button type="submit">@L["Read saved sources"]</button>
    </form>
    @if (Model.Effective is not null)
    {
        foreach (var diagnostic in Model.Effective.Diagnostics) { <p role="status">@diagnostic</p> }
        foreach (var file in Model.Effective.Files)
        {
            <h4>@file.RelativePath</h4>
            <ul>
            @foreach (var source in file.Sources)
            {
                <li>@source.SourceKind @source.HostScope @source.OverlayKey @source.OverlayVersion — @source.EffectiveMergeMode — @(source.IsWinner ? L["Final winner"] : source.IsShadowed ? L["Shadowed"] : L["Contributes through merge"])</li>
            }
            </ul>
        }
    }
</section>
@if (Model.ContentComparison is not null)
{
<section class="card top-gap">
    <h3>@L["Base vs effective content"]</h3>
    @foreach (var diagnostic in Model.ContentComparison.Diagnostics) { <p role="status">@diagnostic</p> }
    @foreach (var file in Model.ContentComparison.Files)
    {
        <h4>@file.RelativePath</h4>
        @foreach (var note in file.Notes) { <p role="status">@note</p> }
        @if (file.BaseAvailable && file.EffectiveAvailable && file.EffectiveDiffers)
        {
            <p><strong>@L["Differences"]</strong></p>
            <pre>@string.Join("\n", file.Diff.Select(line => (line.Kind == "removed" ? "- " : line.Kind == "added" ? "+ " : "  ") + line.Text))</pre>
            <details>
                <summary>@L["Base content"] / @L["Effective content"]</summary>
                <p><strong>@L["Base content"]</strong></p>
                <pre>@file.BaseContent</pre>
                <p><strong>@L["Effective content"]</strong></p>
                <pre>@file.EffectiveContent</pre>
            </details>
        }
        @if (file.ContentTruncated)
        {
            <p role="status">@L["Content truncated for display."]</p>
        }
    }
</section>
}
@if (Model.Detail is not null && Model.RemovalPreview is null)
{
<section class="card top-gap">
    <h3>@L["Preview before disabling or deleting"]</h3>
    <p>@L["No removal preview is shown yet for the opened overlay. To preview before disabling or deleting, choose a host and artifact in Saved effective sources above and read the saved sources: the opened overlay is kept, so the preview is computed for this document on that host and artifact."]</p>
</section>
}
@if (Model.RemovalPreview is not null)
{
<section class="card top-gap">
    <h3>@L["Removal impact preview"]</h3>
    <p>@L["Read-only preview for disabling or deleting the opened overlay on the selected host and artifact. Saved rows only: never live files, disk contents or final deployment configuration. Other hosts or artifacts using this document are not enumerated. Computed against token:"] @Model.PreviewToken(). @L["The Disable and Delete forms in this preview section re-validate every saved row this preview depends on and reject a stale preview. Disable and Delete are only offered here, never as direct operations on the saved list. Reload before changing."]</p>
    @{
        var previewRow = Model.Snapshot.Overlays.FirstOrDefault(o => o.ConfigOverlayDocumentId == Model.RemovalPreview.DocumentId);
    }
    @if (previewRow is not null)
    {
        @if (Model.RemovalPreview.DocumentWasEnabled)
        {
            <form method="post" data-omp-confirm="@L["Change this saved overlay? Enabling disables other versions of the same key and scope. Delete removes the document and its files. No other version is automatically selected after disable or delete."]">
                <input type="hidden" name="id" value="@previewRow.ConfigOverlayDocumentId" />
                <input type="hidden" name="token" value="@ConfigOverlaysModel.Token(previewRow)" />
                <input type="hidden" name="hostKey" value="@Model.RemovalPreview.TargetHostKey" />
                <input type="hidden" name="artifactId" value="@Model.RemovalPreview.TargetArtifactId" />
                <input type="hidden" name="previewToken" value="@Model.PreviewActionToken(false)" data-preview-action="Disable" />
                <button asp-page-handler="Disable" disabled="@(!Model.Snapshot.SchemaReady)">@L["Disable"]</button>
            </form>
        }
        <form method="post" data-omp-confirm="@L["Change this saved overlay? Enabling disables other versions of the same key and scope. Delete removes the document and its files. No other version is automatically selected after disable or delete."]">
            <input type="hidden" name="id" value="@previewRow.ConfigOverlayDocumentId" />
            <input type="hidden" name="token" value="@ConfigOverlaysModel.Token(previewRow)" />
            <input type="hidden" name="hostKey" value="@Model.RemovalPreview.TargetHostKey" />
            <input type="hidden" name="artifactId" value="@Model.RemovalPreview.TargetArtifactId" />
            <input type="hidden" name="previewToken" value="@Model.PreviewActionToken(null)" data-preview-action="Delete" />
            <button asp-page-handler="Delete" class="btn btn-danger" disabled="@(!Model.Snapshot.SchemaReady)">@L["Delete"]</button>
        </form>
        @if (!Model.Snapshot.SchemaReady)
        {
            <p>@L["Schema not ready. Upgrade the platform schema before editing."]</p>
        }
    }
    @if (Model.RemovalPreview.DetailUnavailable)
    {
        <p role="alert">@L["Saved detail for this overlay is currently unavailable, so owned files cannot be listed and this preview is partial."]</p>
    }
    @foreach (var file in Model.RemovalPreview.Files)
    {
        <h4>@file.RelativePath — @file.Outcome</h4>
        <ul>
            <li>@L["Now"]: @(file.CurrentWinner is null ? L["no saved source"].Value : $"{file.CurrentWinner.SourceKind} {file.CurrentWinner.HostScope} {file.CurrentWinner.OverlayKey} {file.CurrentWinner.OverlayVersion}")</li>
            <li>@L["After removal"]: @(file.WinnerAfterRemoval is null ? L["no saved source"].Value : $"{file.WinnerAfterRemoval.SourceKind} {file.WinnerAfterRemoval.HostScope} {file.WinnerAfterRemoval.OverlayKey} {file.WinnerAfterRemoval.OverlayVersion}")</li>
            @foreach (var note in file.Notes) { <li>@note</li> }
        </ul>
    }
    @foreach (var diagnostic in Model.RemovalPreview.Diagnostics) { <p role="status">@diagnostic</p> }
</section>
}
@if (Model.InstallationImpact is not null)
{
<section class="card top-gap">
    <h3>@L["Installation impact"]</h3>
    <p>@L["Read-only impact of disabling or deleting the opened overlay across the configured app contexts of this installation. Saved rows only: never live files, disk contents or final deployment configuration. A context is one configured app on one concrete host with the exact artifact version it runs. No change is offered here."]</p>
    @if (Model.InstallationImpact.Contexts.Count == 0)
    {
        <p>@L["No configured app contexts in this installation."]</p>
    }
    else
    {
        <table class="grid">
            <thead><tr><th>@L["Host"]</th><th>@L["App context"]</th><th>@L["Artifact"]</th><th>@L["State"]</th><th>@L["Files"]</th></tr></thead>
            <tbody>
            @foreach (var context in Model.InstallationImpact.Contexts)
            {
                <tr>
                    <td>@context.HostKey</td>
                    <td>@context.AppInstanceKey (@context.AppKey)</td>
                    <td>@(context.ArtifactId is null ? L["no registered artifact"].Value : $"{context.ArtifactId} / {context.ArtifactVersion}")</td>
                    <td>@context.ContextState</td>
                    <td>
                        @if (context.Files.Count == 0)
                        {
                            <span>@L["No owned files apply."]</span>
                        }
                        else
                        {
                            <ul>
                            @foreach (var file in context.Files)
                            {
                                <li>@file.RelativePath — @file.Outcome — @(file.CurrentWinner is null ? L["no saved source"].Value : $"{file.CurrentWinner.SourceKind} {file.CurrentWinner.HostScope} {file.CurrentWinner.OverlayKey} {file.CurrentWinner.OverlayVersion}") → @(file.WinnerAfterRemoval is null ? L["no saved source"].Value : $"{file.WinnerAfterRemoval.SourceKind} {file.WinnerAfterRemoval.HostScope} {file.WinnerAfterRemoval.OverlayKey} {file.WinnerAfterRemoval.OverlayVersion}")</li>
                            }
                            </ul>
                        }
                        @foreach (var note in context.Notes) { <p role="status">@note</p> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    @if (Model.InstallationImpact.PossibleArtifacts.Count > 0)
    {
        <h4>@L["Possible artifact matches (not deployments)"]</h4>
        <ul>
        @foreach (var artifact in Model.InstallationImpact.PossibleArtifacts)
        {
            <li>@artifact.ArtifactId / @artifact.ModuleKey / @artifact.AppKey / @artifact.PackageType / @artifact.TargetName / @artifact.Version</li>
        }
        </ul>
    }
    @foreach (var diagnostic in Model.InstallationImpact.Diagnostics) { <p role="status">@diagnostic</p> }
</section>
}
