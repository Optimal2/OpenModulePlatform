@page "/admin/systemlog"
@using System.Globalization
@model OpenModulePlatform.Portal.Pages.Admin.SystemLogModel

<section class="page-header">
    <div>
        <div class="eyebrow">@L["System"]</div>
        <h2>
            @L["System log"]
            <span class="info-badge"
                  tabindex="0"
                  role="img"
                  title="@L["What the platform's own processes reported at warning level and above, from every host, in one place. For the people who run the system; the user log is the audit trail of what users did. Rows are pruned by the HostAgent after its retention period."]"
                  aria-label="@L["What the platform's own processes reported at warning level and above, from every host, in one place. For the people who run the system; the user log is the audit trail of what users did. Rows are pruned by the HostAgent after its retention period."]">i</span>
        </h2>
    </div>
</section>

<section class="card top-gap">
    @* The user log's bar, with process and level in place of user and module.
       It shares that page's script and classes on purpose: the same ids and
       data attributes make one script drive both pages, and the same classes
       keep the two log pages looking alike. Every choice applies as soon as
       it is made; the script fetches the page with the new query and swaps
       the results in place (a plain GET submit is the fallback). *@
    <form method="get" class="activity-bar" id="activity-filter-form" data-enhance="false">
        <input type="search"
               class="list-search activity-bar__search"
               data-list-search="activity-list"
               placeholder="@L["Row search"]"
               aria-label="@L["Row search"]"
               title="@L["Filters the loaded rows as you type."]" />
        @{
            var chosenProcesses = Model.AvailableProcesses
                .Where(process => Model.Processes.Contains(process, StringComparer.OrdinalIgnoreCase))
                .ToArray();
        }
        <details class="omp-picker omp-picker--multi activity-bar__modules@(chosenProcesses.Length > 0 ? " omp-picker--active" : null)"
                 data-omp-picker
                 data-omp-picker-static
                 data-activity-picker="processes">
            <summary class="omp-picker__field activity-bar__field"
                     aria-labelledby="systemlog-process-value systemlog-process-count"
                     title="@(chosenProcesses.Length > 0 ? string.Join(", ", chosenProcesses) : L["Process"].Value)"
                     data-omp-picker-title="@L["Process"]">
                <span id="systemlog-process-value" class="omp-picker__label" data-omp-picker-label>@L["Process"]</span>
                <span id="systemlog-process-count" class="omp-picker__count" data-omp-picker-count>@chosenProcesses.Length</span>
            </summary>
            <div class="omp-picker__menu">
                @if (Model.AvailableProcesses.Count == 0)
                {
                    <div class="omp-picker__option muted">@L["No process has written to the system log yet."]</div>
                }
                @foreach (var process in Model.AvailableProcesses)
                {
                    var chosen = Model.Processes.Contains(process, StringComparer.OrdinalIgnoreCase);
                    <label class="omp-picker__option@(chosen ? " omp-picker__option--active" : null)">
                        <input type="checkbox" name="Processes" value="@process" checked="@chosen" data-activity-submit />
                        @process
                    </label>
                }
                <div class="omp-picker__footer">
                    <button type="button" class="omp-picker__clear" data-omp-picker-clear disabled="@(chosenProcesses.Length == 0)">@L["Clear"]</button>
                </div>
            </div>
        </details>
        @{
            var chosenLevels = Model.AvailableLevels
                .Where(level => Model.Levels.Contains(level, StringComparer.OrdinalIgnoreCase))
                .Select(level => L[SystemLogModel.LevelTextKey(level)].Value)
                .ToArray();
        }
        <details class="omp-picker omp-picker--multi activity-bar__users@(chosenLevels.Length > 0 ? " omp-picker--active" : null)"
                 data-omp-picker
                 data-omp-picker-static
                 data-activity-picker="levels">
            <summary class="omp-picker__field activity-bar__field"
                     aria-labelledby="systemlog-level-value systemlog-level-count"
                     title="@(chosenLevels.Length > 0 ? string.Join(", ", chosenLevels) : L["Level"].Value)"
                     data-omp-picker-title="@L["Level"]">
                <span id="systemlog-level-value" class="omp-picker__label" data-omp-picker-label>@L["Level"]</span>
                <span id="systemlog-level-count" class="omp-picker__count" data-omp-picker-count>@chosenLevels.Length</span>
            </summary>
            <div class="omp-picker__menu">
                @foreach (var level in Model.AvailableLevels)
                {
                    var chosen = Model.Levels.Contains(level, StringComparer.OrdinalIgnoreCase);
                    <label class="omp-picker__option@(chosen ? " omp-picker__option--active" : null)">
                        <input type="checkbox" name="Levels" value="@level" checked="@chosen" data-activity-submit />
                        @L[SystemLogModel.LevelTextKey(level)]
                    </label>
                }
                <div class="omp-picker__footer">
                    <button type="button" class="omp-picker__clear" data-omp-picker-clear disabled="@(chosenLevels.Length == 0)">@L["Clear"]</button>
                </div>
            </div>
        </details>
        @{
            var presetToday = DateOnly.FromDateTime(DateTime.UtcNow.Date);
            var presetTodayIso = presetToday.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        }
        <span data-omp-daterange data-range-name="Range" data-from-name="From" data-to-name="To"
              data-field-class="activity-bar__field" data-max="today+30" data-neutral="all" data-precision="minute"
              data-from-text="@L["From date"]" data-to-text="@L["To date"]" data-apply-text="@L["Apply"]" data-cancel-text="@L["Cancel"]">
            <input type="hidden" name="Range" value="@(!string.IsNullOrWhiteSpace(Model.Range) ? Model.Range : (Model.From.HasValue || Model.To.HasValue ? "custom" : "all"))" />
            <input type="hidden" name="From" value="@SystemLogModel.FieldValue(Model.From)" />
            <input type="hidden" name="To" value="@SystemLogModel.FieldValue(Model.To)" />
            <span data-omp-daterange-preset="all">@L["Since the start"]</span>
            <span data-omp-daterange-preset="7d" data-from="@presetToday.AddDays(-6).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" data-to="@presetTodayIso">@L["Last {0} days", 7]</span>
            <span data-omp-daterange-preset="30d" data-from="@presetToday.AddDays(-29).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" data-to="@presetTodayIso">@L["Last {0} days", 30]</span>
            <span data-omp-daterange-preset="90d" data-from="@presetToday.AddDays(-89).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" data-to="@presetTodayIso">@L["Last {0} days", 90]</span>
        </span>
        <a class="btn btn-danger activity-bar__clear"
           href="@Url.Content("~/admin/systemlog")"
           data-activity-clear
           aria-disabled="@(Model.HasFilter ? null : "true")"
           tabindex="@(Model.HasFilter ? null : "-1")">@L["Reset"]</a>
        <span class="activity-bar__spacer"></span>
        <div class="activity-bar__rows">
            <span id="systemlog-rows-label">@L["Rows"]</span>
            <details class="omp-picker" data-omp-picker data-omp-picker-plain>
                <summary class="omp-picker__field activity-bar__field" aria-labelledby="systemlog-rows-label systemlog-rows-value" title="@L["Rows"]">
                    <span id="systemlog-rows-value" data-omp-picker-label>@Model.Take</span>
                </summary>
                <div class="omp-picker__menu omp-picker__menu--end">
                    @foreach (var take in new[] { 50, 200, 500, 1000 })
                    {
                        <label class="omp-picker__option@(Model.Take == take ? " omp-picker__option--active" : null)">
                            <input type="radio" name="Take" value="@take" checked="@(Model.Take == take)" data-activity-submit />
                            @take
                        </label>
                    }
                </div>
            </details>
        </div>
    </form>
</section>

<section class="card top-gap activity-results" id="activity-results" data-activity-results>
    @if (Model.Entries.Count == 0)
    {
        <div class="empty-state">@(Model.HasFilter ? L["No system log entries match the current filters."] : L["No process has reported anything at warning level or above yet."])</div>
    }
    else
    {
        <div class="empty-state" data-list-empty="activity-list" hidden>@L["No rows match the current filters."]</div>
        <div class="table-scroll">
            <table id="activity-list" class="grid activity-grid systemlog-grid sortable-list" data-sortable-list data-list-fit>
                <colgroup>
                    <col class="activity-grid__time" />
                    <col class="activity-grid__user" />
                    <col class="activity-grid__outcome" />
                    <col class="activity-grid__module" />
                    <col class="activity-grid__summary" />
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col" data-sort-type="date"><button type="button" class="sortable-list__button">@L["Time UTC"]</button></th>
                        <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Process"]</button></th>
                        <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Level"]</button></th>
                        <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Logger"]</button></th>
                        <th scope="col">@L["Message"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Entries)
                {
                    var detailId = $"systemlog-detail-{row.SystemLogId}";
                    var hasDetail = !string.IsNullOrWhiteSpace(row.Exception) || !string.IsNullOrWhiteSpace(row.CorrelationId) || row.Message.Length > 200 || row.Message.Contains('\n');
                    // The time stamp is searchable too, so "13:11" narrows the loaded rows to that minute.
                    var searchText = string.Join(' ', SystemLogModel.FormatUtc(row.LoggedUtc), row.HostName, row.ProcessName, row.Level, row.Logger, row.Message, row.Exception ?? string.Empty, row.CorrelationId ?? string.Empty);
                    <tr data-activity-row data-search="@searchText">
                        <td data-sort-value="@row.LoggedUtc.ToString("yyyy-MM-dd'T'HH:mm:ss.fff'Z'", CultureInfo.InvariantCulture)">
                            <code>@SystemLogModel.FormatUtc(row.LoggedUtc)</code>
                        </td>
                        <td data-sort-value="@row.ProcessName">
                            <div>@row.ProcessName</div>
                            <div class="muted">@row.HostName</div>
                        </td>
                        <td data-sort-value="@row.Level">
                            <span class="@SystemLogModel.LevelPillClass(row.Level)">@L[SystemLogModel.LevelTextKey(row.Level)]</span>
                        </td>
                        <td data-sort-value="@row.Logger">
                            <code class="systemlog-grid__logger" title="@row.Logger">@row.Logger</code>
                        </td>
                        <td>
                            <div class="systemlog-grid__message">@row.Message</div>
                            @if (hasDetail)
                            {
                                <button type="button" class="activity-row__hint muted" aria-expanded="false" aria-controls="@detailId">@L["Show details"]</button>
                            }
                        </td>
                    </tr>
                    @if (hasDetail)
                    {
                        <tr class="activity-detail" id="@detailId" data-list-follow>
                            <td colspan="5">
                                @* The whole message, the exception with its stack and the
                                   correlation id; Copy takes the lot as text. *@
                                <div class="activity-detail__head">
                                    <button type="button"
                                            class="btn btn-secondary btn-sm btn-icon btn-leading-icon btn-leading-icon--copy activity-detail__copy"
                                            data-activity-copy
                                            data-label-copy="@L["Copy"]"
                                            data-label-copied="@L["Copied"]"
                                            title="@L["Copy"]"
                                            aria-label="@L["Copy"]"></button>
                                </div>
                                <div class="activity-detail__formatted">
                                    <dl class="activity-detail__fields">
                                        <dt>@L["Host"]</dt>
                                        <dd>@row.HostName</dd>
                                        @if (!string.IsNullOrWhiteSpace(row.CorrelationId))
                                        {
                                            <dt>@L["Correlation"]</dt>
                                            <dd><code>@row.CorrelationId</code></dd>
                                        }
                                        <dt>@L["Message"]</dt>
                                        <dd><pre class="activity-detail__json">@row.Message</pre></dd>
                                        @if (!string.IsNullOrWhiteSpace(row.Exception))
                                        {
                                            <dt>@L["Exception"]</dt>
                                            <dd><pre class="activity-detail__json">@row.Exception</pre></dd>
                                        }
                                    </dl>
                                </div>
                                <div class="activity-detail__rawpanel" hidden>
                                    <pre class="activity-detail__json">@row.LoggedUtc.ToString("yyyy-MM-dd HH:mm:ss.fff", CultureInfo.InvariantCulture) @row.HostName @row.ProcessName @row.Level @row.Logger
@row.Message@(string.IsNullOrWhiteSpace(row.Exception) ? string.Empty : "\n" + row.Exception)</pre>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    }
</section>

<script src="~/js/admin-activitylog.js"></script>
