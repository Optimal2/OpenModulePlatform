@page "/admin/activitylog"
@using Microsoft.AspNetCore.Html
@using System.Globalization
@using OpenModulePlatform.Web.Shared.ActivityLog
@model OpenModulePlatform.Portal.Pages.Admin.ActivityLogModel

<section class="page-header">
    <div>
        <div class="eyebrow">@L["System"]</div>
        <h2>
            @L["User log"]
            <span class="info-badge"
                  tabindex="0"
                  role="img"
                  title="@L["What people did in every module that keeps a user log, attributed to the OMP user who did it. This is an audit trail of user actions, not an error log. Pick a user to follow one person across modules."]"
                  aria-label="@L["What people did in every module that keeps a user log, attributed to the OMP user who did it. This is an audit trail of user actions, not an error log. Pick a user to follow one person across modules."]">i</span>
        </h2>
    </div>
</section>

<section class="card top-gap">
    @* One row: row search, user, modules, period and Clear, then Rows on the
       right. Every choice applies as soon as it is made: the page script
       fetches the page with the new query and swaps the results in place, so
       nothing reloads visibly (a plain GET submit is the fallback). The row
       search is the list component's own search over the loaded rows and
       nothing else: it has no name, so it never reaches the server, and the
       rows it hid come back as soon as it is emptied. User, modules and rows
       are shared pickers (omp-picker) dressed like the period picker, so the
       four dropdowns read as one family. *@
    <form method="get" class="activity-bar" id="activity-filter-form" data-enhance="false">
        <input type="search"
               class="list-search activity-bar__search"
               data-list-search="activity-list"
               placeholder="@L["Row search"]"
               aria-label="@L["Row search"]"
               title="@L["Filters the loaded rows as you type."]" />
        @{
            // A multiple-choice field's text has three states: nothing chosen
            // ("Any user"), one chosen (its name), several ("Anna and 2 others").
            // The name gets its own span, clipped on its own by the shared
            // picker's CSS, so the wording around it stays whole.
            IHtmlContent PickerText(IReadOnlyList<string> chosen, string none)
            {
                if (chosen.Count == 0)
                {
                    return new HtmlString(System.Net.WebUtility.HtmlEncode(none));
                }

                var wording = chosen.Count switch
                {
                    1 => "{0}",
                    2 => L["{0} and one other"].Value,
                    _ => string.Format(CultureInfo.CurrentCulture, L["{0} and {1} others"].Value, "{0}", chosen.Count - 1)
                };
                var parts = wording.Split("{0}", 2);
                var encoded = System.Net.WebUtility.HtmlEncode(chosen[0]);
                return new HtmlString($"{System.Net.WebUtility.HtmlEncode(parts[0])}<span class=\"omp-picker__name\">{encoded}</span>{(parts.Length > 1 ? System.Net.WebUtility.HtmlEncode(parts[1]) : string.Empty)}");
            }
            var chosenUsers = Model.Users
                .Where(user => Model.UserIds.Contains(user.UserId))
                .Select(user => $"{user.DisplayName} ({user.UserId})")
                .ToArray();
        }
        <span id="activity-user-label" class="visually-hidden">@L["User"]</span>
        <details class="omp-picker omp-picker--multi activity-bar__users@(chosenUsers.Length > 0 ? " omp-picker--active" : null)"
                 data-omp-picker
                 data-activity-picker="users"
                 data-omp-picker-empty="@L["Any user"]"
                 data-omp-picker-more-one="@L["{0} and one other"]"
                 data-omp-picker-more="@L["{0} and {1} others"]">
            @* The name is what the field is for plus what it holds ("User,
               Anna"); the label itself is unseen, since the value says enough. *@
            <summary class="omp-picker__field activity-bar__field"
                     aria-labelledby="activity-user-label activity-user-value"
                     title="@(chosenUsers.Length > 0 ? string.Join(", ", chosenUsers) : L["User"].Value)"
                     data-omp-picker-title="@L["User"]">
                <span id="activity-user-value" class="omp-picker__label" data-omp-picker-label>@PickerText(chosenUsers, L["Any user"].Value)</span>
            </summary>
            <div class="omp-picker__menu">
                @foreach (var user in Model.Users)
                {
                    var chosen = Model.UserIds.Contains(user.UserId);
                    <label class="omp-picker__option@(chosen ? " omp-picker__option--active" : null)">
                        <input type="checkbox" name="UserIds" value="@user.UserId" checked="@chosen" data-activity-submit />
                        @user.DisplayName (@user.UserId)
                    </label>
                }
            </div>
        </details>
        @if (Model.AvailableModules.Count > 0)
        {
            @* A multiple choice: the field names the first chosen module (in
               list order) and says how many more, "Dokumentbibliotek and 2
               others"; every chosen name is in the field's title. *@
            var chosenModules = Model.AvailableModules
                .Where(module => Model.Modules.Contains(module.ModuleKey, StringComparer.OrdinalIgnoreCase))
                .Select(module => module.DisplayName)
                .ToArray();
            <span id="activity-module-label" class="visually-hidden">@L["Module"]</span>
            <details class="omp-picker omp-picker--multi activity-bar__modules@(chosenModules.Length > 0 ? " omp-picker--active" : null)"
                     data-omp-picker
                     data-activity-picker="modules"
                     data-omp-picker-empty="@L["All modules"]"
                     data-omp-picker-more-one="@L["{0} and one other"]"
                     data-omp-picker-more="@L["{0} and {1} others"]">
                <summary class="omp-picker__field activity-bar__field"
                         aria-labelledby="activity-module-label activity-module-value"
                         title="@(chosenModules.Length > 0 ? string.Join(", ", chosenModules) : L["Module"].Value)"
                         data-omp-picker-title="@L["Module"]">
                    <span id="activity-module-value" class="omp-picker__label" data-omp-picker-label>@PickerText(chosenModules, L["All modules"].Value)</span>
                </summary>
                <div class="omp-picker__menu">
                    @foreach (var module in Model.AvailableModules)
                    {
                        var chosen = Model.Modules.Contains(module.ModuleKey, StringComparer.OrdinalIgnoreCase);
                        <label class="omp-picker__option@(chosen ? " omp-picker__option--active" : null)">
                            <input type="checkbox" name="Modules" value="@module.ModuleKey" checked="@chosen" data-activity-submit />
                            @module.DisplayName
                        </label>
                    }
                </div>
            </details>
        }
        @{
            var presetToday = DateOnly.FromDateTime(DateTime.UtcNow.Date);
            var presetTodayIso = presetToday.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        }
        <span data-omp-daterange data-range-name="Range" data-from-name="From" data-to-name="To"
              data-field-class="activity-bar__field" data-max="today"
              data-from-text="@L["From date"]" data-to-text="@L["To date"]" data-apply-text="@L["Apply"]">
            <input type="hidden" name="Range" value="@Model.Range" />
            <input type="hidden" name="From" value="@(Model.From?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" />
            <input type="hidden" name="To" value="@(Model.To?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" />
            <span data-omp-daterange-preset="all" data-to="@presetTodayIso">@L["Since the start"]</span>
            <span data-omp-daterange-preset="today" data-from="@presetTodayIso" data-to="@presetTodayIso">@L["Today"]</span>
            <span data-omp-daterange-preset="7d" data-from="@presetToday.AddDays(-6).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" data-to="@presetTodayIso">@L["Last {0} days", 7]</span>
            <span data-omp-daterange-preset="30d" data-from="@presetToday.AddDays(-29).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" data-to="@presetTodayIso">@L["Last {0} days", 30]</span>
            <span data-omp-daterange-preset="90d" data-from="@presetToday.AddDays(-89).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" data-to="@presetTodayIso">@L["Last {0} days", 90]</span>
        </span>
        @* Clear is a plain link back to the unfiltered page, next to the
           filters it clears; it is greyed out while there is nothing to clear
           (the script also enables it as soon as the row search holds text). *@
        <a class="btn btn-danger activity-bar__clear"
           href="@Url.Content("~/admin/activitylog")"
           data-activity-clear
           aria-disabled="@(Model.HasFilter ? null : "true")"
           tabindex="@(Model.HasFilter ? null : "-1")">@L["Clear"]</a>
        <span class="activity-bar__spacer"></span>
        <div class="activity-bar__rows">
            <span id="activity-rows-label">@L["Rows"]</span>
            <details class="omp-picker" data-omp-picker data-omp-picker-plain>
                @* A number alone says nothing: the name is "Rows" plus the value. *@
                <summary class="omp-picker__field activity-bar__field" aria-labelledby="activity-rows-label activity-rows-value" title="@L["Rows"]">
                    <span id="activity-rows-value" data-omp-picker-label>@Model.Take</span>
                </summary>
                @* At the right edge of the row, so the panel hangs from the field's right corner. *@
                <div class="omp-picker__menu omp-picker__menu--end">
                    @foreach (var take in new[] { 50, 200, 500, 1000 })
                    {
                        <label class="omp-picker__option@(Model.Take == take ? " omp-picker__option--active" : null)">
                            <input type="radio" name="Take" value="@take" checked="@(Model.Take == take)" data-activity-submit />
                            @take
                        </label>
                    }
                </div>
            </details>
        </div>
    </form>
</section>

<section class="card top-gap activity-results" id="activity-results" data-activity-results>
    @if (Model.AvailableModules.Count == 0)
    {
        <div class="empty-state">@L["No enabled module has an activity log table yet."]</div>
    }
    else if (Model.Entries.Count == 0)
    {
        <div class="empty-state">@(Model.HasFilter ? L["No activity matches the current filters."] : L["No activity has been logged yet."])</div>
    }
    else
    {
        <div class="empty-state" data-list-empty="activity-list" hidden>@L["No rows match the current filters."]</div>
        <div class="table-scroll">
            <table id="activity-list" class="grid activity-grid sortable-list" data-sortable-list data-list-fit>
                <colgroup>
                    <col class="activity-grid__time" />
                    <col class="activity-grid__user" />
                    <col class="activity-grid__module" />
                    <col class="activity-grid__event" />
                    <col class="activity-grid__outcome" />
                    <col class="activity-grid__summary" />
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col" data-sort-type="date"><button type="button" class="sortable-list__button">@L["Time UTC"]</button></th>
                        <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["User"]</button></th>
                        <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Module"]</button></th>
                        <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Event"]</button></th>
                        <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Outcome"]</button></th>
                        <th scope="col">@L["Summary"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var entry in Model.Entries)
                {
                    var row = entry.Row;
                    var detailId = $"activity-detail-{row.ModuleKey}-{row.ActivityLogId}";
                    <tr data-activity-row data-search="@row.Entry">
                        <td data-sort-value="@row.LoggedUtc.ToString("yyyy-MM-dd'T'HH:mm:ss.fff'Z'", CultureInfo.InvariantCulture)">
                            <code>@ActivityLogModel.FormatUtc(row.LoggedUtc)</code>
                        </td>
                        <td data-sort-value="@(row.UserDisplayName ?? string.Empty)">
                            @if (row.OmpUserId.HasValue)
                            {
                                <div>@(row.UserDisplayName ?? L["Unknown user"].Value)</div>
                                <div class="muted">#@row.OmpUserId</div>
                            }
                            else
                            {
                                @* A user log entry always belongs to a person; a row without an id is a defect in the writer, not a system action. *@
                                <span class="muted">@L["Unknown user"]</span>
                            }
                        </td>
                        <td data-sort-value="@row.ModuleDisplayName">
                            <div>@row.ModuleDisplayName</div>
                            <div class="muted"><code>@row.ModuleKey</code></div>
                        </td>
                        <td data-sort-value="@entry.Event">
                            @if (entry.IsUnreadable)
                            {
                                <span class="pill pill-warning">@L["Unreadable entry"]</span>
                            }
                            else
                            {
                                <code>@entry.Event</code>
                            }
                        </td>
                        <td data-sort-value="@entry.Outcome">
                            @if (!entry.IsUnreadable)
                            {
                                <span class="pill @(entry.Outcome == ActivityOutcomes.Ok ? "" : "pill-warning")">@entry.Outcome</span>
                            }
                        </td>
                        <td>
                            <div>@entry.Summary</div>
                            <button type="button" class="activity-row__hint muted" aria-expanded="false" aria-controls="@detailId">@L["Show details"]</button>
                        </td>
                    </tr>
                    <tr class="activity-detail" id="@detailId" data-list-follow>
                        <td colspan="6">
                            @* Two views of the same entry: the formatted fields and the
                               stored JSON. A toggle swaps them; the formatted view is the
                               default, so the raw text is one click away instead of a fold.
                               The toggle names the view it leads to, with the matching
                               icon: braces for the raw JSON, a document for the
                               formatted fields. Copy is icon-only; its tooltip carries
                               the word and turns into "Copied" for a moment. *@
                            <div class="activity-detail__head">
                                <button type="button"
                                        class="btn btn-secondary btn-sm btn-icon btn-leading-icon btn-leading-icon--copy activity-detail__copy"
                                        data-activity-copy
                                        data-label-copy="@L["Copy"]"
                                        data-label-copied="@L["Copied"]"
                                        title="@L["Copy"]"
                                        aria-label="@L["Copy"]"
                                        hidden></button>
                                <button type="button"
                                        class="btn btn-secondary btn-sm btn-leading-icon btn-leading-icon--data-object activity-detail__toggle"
                                        aria-pressed="false"
                                        data-activity-raw-toggle
                                        data-label-raw="@L["Raw entry"]"
                                        data-label-formatted="@L["Formatted entry"]">@L["Raw entry"]</button>
                            </div>
                            <div class="activity-detail__formatted">
                                @if (entry.Envelope is { } envelope)
                                {
                                    <dl class="activity-detail__fields">
                                        @if (envelope.Subject is { } subject)
                                        {
                                            <dt>@L["Subject"]</dt>
                                            <dd><code>@subject.Type</code> @subject.Id @if (!string.IsNullOrWhiteSpace(subject.Label)) { <span class="muted">(@subject.Label)</span> }</dd>
                                        }
                                        @if (envelope.Actor is { } actor)
                                        {
                                            <dt>@L["Actor"]</dt>
                                            <dd>@actor.Name <span class="muted">(@actor.Kind)</span></dd>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(envelope.App))
                                        {
                                            <dt>@L["App"]</dt>
                                            <dd><code>@envelope.App</code></dd>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(envelope.Correlation))
                                        {
                                            <dt>@L["Correlation"]</dt>
                                            <dd><code>@envelope.Correlation</code></dd>
                                        }
                                        @if (envelope.Data is { } data)
                                        {
                                            <dt>@L["Data"]</dt>
                                            <dd><pre class="activity-detail__json">@ActivityLogModel.Pretty(data)</pre></dd>
                                        }
                                        @* Envelope version 2 records which message template the
                                           summary came from and the values that filled it. No
                                           translation reads them yet; they are shown so the pilot
                                           can be checked, and so an auditor sees what is stored. *@
                                        @if (!string.IsNullOrWhiteSpace(envelope.MessageKey))
                                        {
                                            <dt>@L["Message key"]</dt>
                                            <dd><code>@envelope.MessageKey</code></dd>
                                        }
                                        @if (envelope.Args is { } args)
                                        {
                                            <dt>@L["Arguments"]</dt>
                                            <dd><pre class="activity-detail__json">@ActivityLogModel.Pretty(args)</pre></dd>
                                        }
                                        <dt>@L["Envelope version"]</dt>
                                        <dd>@envelope.V</dd>
                                    </dl>
                                }
                                else
                                {
                                    <p class="muted">@L["This entry could not be read as a user log envelope. The stored text is shown as is."]</p>
                                }
                            </div>
                            <div class="activity-detail__rawpanel" hidden>
                                <pre class="activity-detail__json">@row.Entry</pre>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<script src="~/js/admin-activitylog.js"></script>
