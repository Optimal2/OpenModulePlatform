@page "/admin/activitylog"
@using System.Globalization
@using OpenModulePlatform.Web.Shared.ActivityLog
@model OpenModulePlatform.Portal.Pages.Admin.ActivityLogModel

<section class="page-header">
    <div>
        <div class="eyebrow">@L["System"]</div>
        <h2>
            @L["User log"]
            <span class="info-badge"
                  tabindex="0"
                  role="img"
                  title="@L["What people did in every module that keeps a user log, attributed to the OMP user who did it. This is an audit trail of user actions, not an error log. Pick a user to follow one person across modules."]"
                  aria-label="@L["What people did in every module that keeps a user log, attributed to the OMP user who did it. This is an audit trail of user actions, not an error log. Pick a user to follow one person across modules."]">i</span>
        </h2>
    </div>
</section>

<section class="card top-gap">
    @* One row: row search, user, modules, period, then Clear and Rows on the
       right. Every choice applies as soon as it is made (the page script
       submits the GET form), so there is no Apply button. The row search is
       the list component's own search over the loaded rows; Enter runs the
       same text as a server-side search across everything the filters allow. *@
    <form method="get" class="activity-bar" id="activity-filter-form" data-enhance="false">
        <input type="search"
               class="list-search activity-bar__search"
               name="Q"
               value="@Model.Q"
               data-list-search="activity-list"
               placeholder="@L["Row search"]"
               aria-label="@L["Row search"]"
               title="@L["Filters the loaded rows as you type; Enter searches the summary and event of everything the filters allow."]" />
        <select name="UserId" class="activity-bar__field" aria-label="@L["User"]" data-activity-submit>
            <option value="">@L["Any user"]</option>
            @foreach (var user in Model.Users)
            {
                <option value="@user.UserId" selected="@(Model.UserId == user.UserId)">@user.DisplayName (@user.UserId)</option>
            }
        </select>
        @if (Model.AvailableModules.Count > 0)
        {
            <details class="list-filter activity-bar__modules @(Model.Modules.Length > 0 ? "list-filter--active" : null)">
                <summary class="btn btn-secondary">@L["Module"]<span class="list-filter__count" hidden="@(Model.Modules.Length == 0 ? "hidden" : null)">@Model.Modules.Length</span></summary>
                <div class="list-filter__menu">
                    @foreach (var module in Model.AvailableModules)
                    {
                        <label class="list-filter__option">
                            <input type="checkbox" name="Modules" value="@module.ModuleKey" checked="@Model.Modules.Contains(module.ModuleKey, StringComparer.OrdinalIgnoreCase)" data-activity-submit />
                            @module.DisplayName
                        </label>
                    }
                </div>
            </details>
        }
        @{
            var presetToday = DateOnly.FromDateTime(DateTime.UtcNow.Date);
            var presetTodayIso = presetToday.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        }
        <span data-omp-daterange data-range-name="Range" data-from-name="From" data-to-name="To"
              data-field-class="activity-bar__field" data-max="today"
              data-from-text="@L["From date"]" data-to-text="@L["To date"]" data-apply-text="@L["Apply"]">
            <input type="hidden" name="Range" value="@Model.Range" />
            <input type="hidden" name="From" value="@(Model.From?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" />
            <input type="hidden" name="To" value="@(Model.To?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" />
            <span data-omp-daterange-preset="all" data-to="@presetTodayIso">@L["Since the start"]</span>
            <span data-omp-daterange-preset="today" data-from="@presetTodayIso" data-to="@presetTodayIso">@L["Today"]</span>
            <span data-omp-daterange-preset="7d" data-from="@presetToday.AddDays(-6).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" data-to="@presetTodayIso">@L["Last {0} days", 7]</span>
            <span data-omp-daterange-preset="30d" data-from="@presetToday.AddDays(-29).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" data-to="@presetTodayIso">@L["Last {0} days", 30]</span>
            <span data-omp-daterange-preset="90d" data-from="@presetToday.AddDays(-89).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" data-to="@presetTodayIso">@L["Last {0} days", 90]</span>
        </span>
        <span class="activity-bar__spacer"></span>
        <a class="btn btn-danger" href="@Url.Content("~/admin/activitylog")">@L["Clear"]</a>
        <label class="activity-bar__rows">
            <span>@L["Rows"]</span>
            <select name="Take" class="activity-bar__field" aria-label="@L["Rows"]" data-activity-submit>
                @foreach (var take in new[] { 50, 200, 500, 1000 })
                {
                    <option value="@take" selected="@(Model.Take == take)">@take</option>
                }
            </select>
        </label>
    </form>
</section>

<section class="card top-gap">
    @if (Model.AvailableModules.Count == 0)
    {
        <div class="empty-state">@L["No enabled module has an activity log table yet."]</div>
    }
    else if (Model.Entries.Count == 0)
    {
        <div class="empty-state">@(Model.HasFilter ? L["No activity matches the current filters."] : L["No activity has been logged yet."])</div>
    }
    else
    {
        <div class="toolbar">
            <span class="list-count" data-list-count="activity-list" data-template="@L["Showing {0} of {1} rows."]"></span>
        </div>
        <div class="empty-state" data-list-empty="activity-list" hidden>@L["No rows match the current filters."]</div>
        <div class="table-scroll">
            <table id="activity-list" class="grid activity-grid sortable-list" data-sortable-list data-list-fit>
                <colgroup>
                    <col class="activity-grid__time" />
                    <col class="activity-grid__user" />
                    <col class="activity-grid__module" />
                    <col class="activity-grid__event" />
                    <col class="activity-grid__outcome" />
                    <col class="activity-grid__summary" />
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col" data-sort-type="date"><button type="button" class="sortable-list__button">@L["Time UTC"]</button></th>
                        <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["User"]</button></th>
                        <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Module"]</button></th>
                        <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Event"]</button></th>
                        <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Outcome"]</button></th>
                        <th scope="col">@L["Summary"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var entry in Model.Entries)
                {
                    var row = entry.Row;
                    var detailId = $"activity-detail-{row.ModuleKey}-{row.ActivityLogId}";
                    <tr data-activity-row data-search="@row.Entry">
                        <td data-sort-value="@row.LoggedUtc.ToString("yyyy-MM-dd'T'HH:mm:ss.fff'Z'", CultureInfo.InvariantCulture)">
                            <code>@ActivityLogModel.FormatUtc(row.LoggedUtc)</code>
                        </td>
                        <td data-sort-value="@(row.UserDisplayName ?? string.Empty)">
                            @if (row.OmpUserId.HasValue)
                            {
                                <div>@(row.UserDisplayName ?? L["Unknown user"].Value)</div>
                                <div class="muted">#@row.OmpUserId</div>
                            }
                            else
                            {
                                @* A user log entry always belongs to a person; a row without an id is a defect in the writer, not a system action. *@
                                <span class="muted">@L["Unknown user"]</span>
                            }
                        </td>
                        <td data-sort-value="@row.ModuleDisplayName">
                            <div>@row.ModuleDisplayName</div>
                            <div class="muted"><code>@row.ModuleKey</code></div>
                        </td>
                        <td data-sort-value="@entry.Event">
                            @if (entry.IsUnreadable)
                            {
                                <span class="pill pill-warning">@L["Unreadable entry"]</span>
                            }
                            else
                            {
                                <code>@entry.Event</code>
                            }
                        </td>
                        <td data-sort-value="@entry.Outcome">
                            @if (!entry.IsUnreadable)
                            {
                                <span class="pill @(entry.Outcome == ActivityOutcomes.Ok ? "" : "pill-warning")">@entry.Outcome</span>
                            }
                        </td>
                        <td>
                            <div>@entry.Summary</div>
                            <button type="button" class="activity-row__hint muted" aria-expanded="false" aria-controls="@detailId">@L["Show details"]</button>
                        </td>
                    </tr>
                    <tr class="activity-detail" id="@detailId" data-list-follow>
                        <td colspan="6">
                            @if (entry.Envelope is { } envelope)
                            {
                                <dl class="activity-detail__fields">
                                    @if (envelope.Subject is { } subject)
                                    {
                                        <dt>@L["Subject"]</dt>
                                        <dd><code>@subject.Type</code> @subject.Id @if (!string.IsNullOrWhiteSpace(subject.Label)) { <span class="muted">(@subject.Label)</span> }</dd>
                                    }
                                    @if (envelope.Actor is { } actor)
                                    {
                                        <dt>@L["Actor"]</dt>
                                        <dd>@actor.Name <span class="muted">(@actor.Kind)</span></dd>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(envelope.App))
                                    {
                                        <dt>@L["App"]</dt>
                                        <dd><code>@envelope.App</code></dd>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(envelope.Correlation))
                                    {
                                        <dt>@L["Correlation"]</dt>
                                        <dd><code>@envelope.Correlation</code></dd>
                                    }
                                    @if (envelope.Data is { } data)
                                    {
                                        <dt>@L["Data"]</dt>
                                        <dd><pre class="activity-detail__json">@ActivityLogModel.Pretty(data)</pre></dd>
                                    }
                                </dl>
                            }
                            else
                            {
                                <p class="muted">@L["This entry uses an envelope version this viewer does not understand. The stored text is shown as is."]</p>
                            }
                            <details class="activity-detail__raw">
                                <summary>@L["Raw entry"]</summary>
                                <pre class="activity-detail__json">@row.Entry</pre>
                            </details>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<script src="~/js/admin-activitylog.js"></script>
