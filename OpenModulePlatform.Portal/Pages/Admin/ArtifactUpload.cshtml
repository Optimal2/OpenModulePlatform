@page
@model OpenModulePlatform.Portal.Pages.Admin.ArtifactUploadModel

<section class="page-header">
    <div>
        <div class="eyebrow">@L["Artifacts"]</div>
        <h2>@L["Upload artifact"]</h2>
        <p class="lede">@L["Upload one immutable artifact zip, unpack it into the central artifact store, and register it for HostAgent deployment."]</p>
    </div>
</section>

@await Component.InvokeAsync("OmpFeedback", new { message = Model.StatusMessage })

<form method="post" enctype="multipart/form-data" class="card form-grid">
    <div class="form-field">
        <label asp-for="Input.ZipFile"></label>
        <input asp-for="Input.ZipFile" type="file" accept=".zip,application/zip" />
        <div class="field-help">@L["Recognized filename format:"] <code>@Model.MetadataFilenameFormat</code></div>
        <div class="field-help">@L["Legacy artifact zips must not include runtime configuration files such as appsettings*.json or odv.site.config.js. Use an OMP artifact package manifest when configuration files should be registered together with the artifact."]</div>
        <span asp-validation-for="Input.ZipFile" class="field-validation-error"></span>
    </div>

    <div class="field-grid field-grid--2">
        <div class="form-field">
            <label asp-for="Input.AppId"></label>
            <select asp-for="Input.AppId">
                <option value="">@L["Select app"]</option>
                @foreach (var option in Model.AppOptions)
                {
                    <option
                        value="@option.AppId"
                        data-module-key="@option.ModuleKey"
                        data-app-key="@option.AppKey">
                        @option.Label
                    </option>
                }
            </select>
            <span asp-validation-for="Input.AppId" class="field-validation-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Input.PackageType"></label>
            <select asp-for="Input.PackageType">
                <option value="">@L["Select package type"]</option>
                @foreach (var option in Model.PackageTypeOptions)
                {
                    <option value="@option.Value">@option.Label</option>
                }
            </select>
            <span asp-validation-for="Input.PackageType" class="field-validation-error"></span>
        </div>
    </div>

    <div class="field-grid field-grid--3">
        <div class="form-field">
            <label asp-for="Input.TargetName"></label>
            <input asp-for="Input.TargetName" />
            <span asp-validation-for="Input.TargetName" class="field-validation-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Input.Version"></label>
            <input asp-for="Input.Version" />
            <span asp-validation-for="Input.Version" class="field-validation-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Input.RelativePath"></label>
            <input asp-for="Input.RelativePath" />
            <span asp-validation-for="Input.RelativePath" class="field-validation-error"></span>
        </div>
    </div>

    <div class="form-field checkbox-row checkbox-row--boxed">
        <input asp-for="Input.CopyConfigurationFilesFromPreviousVersion" type="checkbox" />
        <div>
            <label asp-for="Input.CopyConfigurationFilesFromPreviousVersion"></label>
            <div class="field-help">@L["Copies artifact configuration file rows from the latest previous artifact with the same app, package type, and target when the uploaded package does not declare configuration files."]</div>
        </div>
    </div>

    <div class="form-field checkbox-row checkbox-row--boxed">
        <input asp-for="Input.UseArtifactImmediately" type="checkbox" />
        <div>
            <label asp-for="Input.UseArtifactImmediately"></label>
            <div class="field-help">@L["Updates matching desired app rows so HostAgent starts deploying this artifact on its next cycle."]</div>
        </div>
    </div>

    <div class="form-field checkbox-row checkbox-row--boxed">
        <input asp-for="Input.ReplaceExistingArtifact" type="checkbox" />
        <div>
            <label for="Input_ReplaceExistingArtifact">@L["Replace existing artifact with same identity"]</label>
            <div class="field-help">@L["Only use this when the same app, package type, target, and version already exists and the uploaded content should intentionally replace it. Automatic import never performs this replacement."]</div>
        </div>
    </div>

    <div class="toolbar">
        <button type="submit">@L["Upload artifact"]</button>
        <a class="action-link" href="~/admin/artifacts">@L["Back to artifacts"]</a>
    </div>
</form>

<script src="~/js/admin-artifact-upload.js"></script>
