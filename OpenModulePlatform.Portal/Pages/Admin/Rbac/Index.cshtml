@page
@model OpenModulePlatform.Portal.Pages.Admin.Rbac.IndexModel
@{
    var ompBranding = await OmpBrandingService.GetBrandingAsync(ViewContext.HttpContext.RequestAborted);
}

<section class="page-header">
    <div>
        <div class="eyebrow">@L["Security and access"]</div>
        <h2>@L["Security"] <span class="info-badge" tabindex="0" role="img" title="@ompBranding.ApplyTerms(L["Manage roles, permissions and principal assignments from Portal instead of editing the database directly."].Value)" aria-label="@ompBranding.ApplyTerms(L["Manage roles, permissions and principal assignments from Portal instead of editing the database directly."].Value)">i</span></h2>
    </div>
</section>

<div class="card-grid bottom-gap">
    <div class="card">
        <div class="metric">@Model.RoleCount</div>
        <div>@L["Roles"]</div>
        <div class="muted small-text top-gap">
            @L["Named access bundles that can carry multiple permissions and principals."]
        </div>
    </div>

    <div class="card">
        <div class="metric">@Model.PermissionCount</div>
        <div>@L["Permissions"]</div>
        <div class="muted small-text top-gap">
            @ompBranding.ApplyTerms(L["Low-level capabilities granted to apps and portal areas."].Value)
        </div>
    </div>
</div>

<div class="section-grid section-grid--wide">
    <section class="card section-card">
        <div class="eyebrow">@L["Role administration"]</div>
        <h3>@L["Manage roles"] <span class="info-badge" tabindex="0" role="img" title="@L["Roles are the main RBAC editing surface. Add permissions and principals here so access remains grouped and auditable."]" aria-label="@L["Roles are the main RBAC editing surface. Add permissions and principals here so access remains grouped and auditable."]">i</span></h3>
        <div class="toolbar">
            <a class="action-link" href="~/admin/security/roles">@L["Open roles"]</a>
            <a class="action-link" href="~/admin/security/role">@L["Create role"]</a>
        </div>
    </section>

    <section class="card section-card">
        <div class="eyebrow">@L["Permission catalog"]</div>
        <h3>@L["Manage permissions"] <span class="info-badge" tabindex="0" role="img" title="@L["Permissions are stable capability names used by roles and apps. Prefer precise names that do not require frequent renaming."]" aria-label="@L["Permissions are stable capability names used by roles and apps. Prefer precise names that do not require frequent renaming."]">i</span></h3>
        <div class="toolbar">
            <a class="action-link" href="~/admin/security/permissions">@L["Open permissions"]</a>
            <a class="action-link" href="~/admin/security/permissionedit">@L["Create permission"]</a>
        </div>
    </section>
</div>
