@page
@using OpenModulePlatform.Web.Shared.Navigation
@model OpenModulePlatform.Portal.Pages.Admin.MaintenanceModel

@{
    const string StatusSectionId = "maintenance-status";
    const string ScanSectionId = "maintenance-scan";
    const string RetentionSectionId = "maintenance-retention";
    const string JobsSectionId = "maintenance-jobs";
    const string PreviewSectionId = "maintenance-preview";

    var candidateGroups = Model.Preview.Candidates
        .GroupBy(row => row.IdentityKey)
        .OrderBy(group => group.First().ModuleKey)
        .ThenBy(group => group.First().AppKey)
        .ThenBy(group => group.First().PackageType)
        .ThenBy(group => group.First().TargetName);

    var sectionNavigatorItems = new List<SectionNavigatorItem>();
    if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        sectionNavigatorItems.Add(new SectionNavigatorItem(L["Status"].Value, StatusSectionId));
    }

    sectionNavigatorItems.Add(new SectionNavigatorItem(L["OMP scan"].Value, ScanSectionId));
    sectionNavigatorItems.Add(new SectionNavigatorItem(L["HostAgent job queue"].Value, JobsSectionId));
    sectionNavigatorItems.Add(new SectionNavigatorItem(L["Artifact retention"].Value, RetentionSectionId));

    var sectionNavigator = new SectionNavigatorModel
    {
        Label = L["Page sections"].Value,
        RootText = L["Maintenance"].Value,
        Items = sectionNavigatorItems
    };
}

<div class="section-navigator-layout">
    <div class="section-navigator-layout__header">
        <section class="page-header">
            <div>
                <div class="eyebrow">@L["System"]</div>
                <h2>@L["Maintenance"] <span class="info-badge" tabindex="0" role="img" title="@L["Use maintenance tasks to remove old platform data that is intentionally kept in multiple versions. Artifact cleanup keeps the newest registered versions per artifact identity and only deletes older versions that are not referenced by desired runtime configuration."]" aria-label="@L["Use maintenance tasks to remove old platform data that is intentionally kept in multiple versions. Artifact cleanup keeps the newest registered versions per artifact identity and only deletes older versions that are not referenced by desired runtime configuration."]">i</span></h2>
            </div>
        </section>
    </div>

    @await Component.InvokeAsync("SectionNavigator", new { model = sectionNavigator })
    <div class="section-navigator-layout__content">

<div id="@StatusSectionId" class="section-navigator-target">
    @await Component.InvokeAsync("OmpFeedback", new { message = Model.StatusMessage })
</div>

<section id="@ScanSectionId" class="card top-gap section-navigator-target">
    <div class="split-header">
        <div>
            <h3>@L["OMP scan"]</h3>
            <p class="muted">@L["Scan the shared installation and every enabled host for stale HostAgent runtime rows, stopped old HostAgent services, stopped old WorkerManager services, and leftover HostAgent folders. The scan only reports candidates; cleanup is queued separately after review."]</p>
        </div>
        <form method="post">
            <button type="submit" asp-page-handler="QueueMaintenanceScan">@L["Start OMP scan"]</button>
        </form>
    </div>

    @if (Model.MaintenanceFindings.Count == 0)
    {
        <div class="empty-state top-gap">@L["No open maintenance findings. Start a scan to collect new findings."]</div>
    }
    else
    {
        <form method="post" class="top-gap">
            <div class="toolbar">
                <button type="submit"
                        asp-page-handler="CleanupMaintenanceFindings"
                        class="btn btn-danger"
                        data-omp-confirm="@L["Queue cleanup jobs for the selected maintenance findings? HostAgents will revalidate each target before deleting anything."]"
                        data-omp-confirm-ok="@L["Queue cleanup"]"
                        data-omp-confirm-cancel="@L["Cancel"]">
                    @L["Queue cleanup"]
                </button>
                <button type="submit"
                        asp-page-handler="IgnoreMaintenanceFindings"
                        class="btn btn-secondary">
                    @L["Ignore selected"]
                </button>
            </div>

            <div class="table-scroll top-gap">
                <table class="grid">
                    <thead>
                        <tr>
                            <th>
                                <input type="checkbox"
                                       id="select-maintenance-findings"
                                       aria-label="@L["Select all maintenance findings"]" />
                            </th>
                            <th>@L["Target"]</th>
                            <th>@L["Host"]</th>
                            <th>@L["Status"]</th>
                            <th>@L["Safety"]</th>
                            <th>@L["Last seen UTC"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.MaintenanceFindings)
                    {
                        <tr>
                            <td>
                                <input type="checkbox"
                                       name="SelectedMaintenanceFindingIds"
                                       value="@row.MaintenanceFindingId"
                                       class="maintenance-finding-checkbox"
                                       aria-label="@L["Select maintenance finding {0}", row.MaintenanceFindingId]" />
                            </td>
                            <td>
                                <strong>@row.Title</strong>
                                <div class="muted">@row.Category / @row.TargetKind</div>
                                <code>@row.TargetIdentifier</code>
                                @if (!string.IsNullOrWhiteSpace(row.Detail))
                                {
                                    <details class="top-gap-sm">
                                        <summary>@L["Details"]</summary>
                                        <div>@row.Detail</div>
                                        @if (!string.IsNullOrWhiteSpace(row.RecommendedAction))
                                        {
                                            <div class="top-gap-sm"><strong>@L["Recommended action"]:</strong> @row.RecommendedAction</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(row.SafetyNotes))
                                        {
                                            <div class="top-gap-sm"><strong>@L["Why this is considered safe"]:</strong> @row.SafetyNotes</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(row.ResultMessage))
                                        {
                                            <div class="top-gap-sm"><strong>@L["Result"]:</strong> @row.ResultMessage</div>
                                        }
                                    </details>
                                }
                            </td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(row.HostKey))
                                {
                                    <span class="muted">@L["Shared"]</span>
                                }
                                else
                                {
                                    <code>@row.HostKey</code>
                                    @if (!string.IsNullOrWhiteSpace(row.HostDisplayName))
                                    {
                                        <div class="muted">@row.HostDisplayName</div>
                                    }
                                }
                            </td>
                            <td><span class="pill">@L[MaintenanceModel.FormatMaintenanceFindingStatus(row.Status)]</span></td>
                            <td>
                                <div>@L["Severity"]: @row.Severity</div>
                                <div>@L["Confidence"]: @row.Confidence%</div>
                            </td>
                            <td>@row.LastSeenUtc.ToString("u")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </form>
    }
</section>

<section id="@JobsSectionId" class="card top-gap section-navigator-target">
    <h3>@L["HostAgent job queue"]</h3>
    <p class="muted">@L["HostAgent jobs are queued in the database and picked up by the matching host during its next cycle."]</p>

    @if (Model.RecentHostAgentJobs.Count == 0)
    {
        <div class="empty-state">@L["No HostAgent jobs have been queued yet."]</div>
    }
    else
    {
        <div class="toolbar">
            <details class="list-filter" data-list-filter="hostagent-jobs-list">
                <summary class="btn btn-ghost">@L["Filter"]<span class="list-filter__count" data-filter-count hidden></span></summary>
                <div class="list-filter__menu">
                    <fieldset class="list-filter__group" data-filter-group="status">
                        <legend>@L["Status"]</legend>
                        <label class="list-filter__option"><input type="checkbox" data-filter-column="2" data-filter-equals="@HostAgentJobStatuses.Pending" /> @L["Pending"]</label>
                        <label class="list-filter__option"><input type="checkbox" data-filter-column="2" data-filter-equals="@HostAgentJobStatuses.Running" /> @L["Running"]</label>
                        <label class="list-filter__option"><input type="checkbox" data-filter-column="2" data-filter-equals="@HostAgentJobStatuses.Succeeded" /> @L["Succeeded"]</label>
                        <label class="list-filter__option"><input type="checkbox" data-filter-column="2" data-filter-equals="@HostAgentJobStatuses.Warning" /> @L["Warning"]</label>
                        <label class="list-filter__option"><input type="checkbox" data-filter-column="2" data-filter-equals="@HostAgentJobStatuses.Failed" /> @L["Failed"]</label>
                        <label class="list-filter__option"><input type="checkbox" data-filter-column="2" data-filter-equals="@HostAgentJobStatuses.Cancelled" /> @L["Cancelled"]</label>
                    </fieldset>
                    <button type="button" class="btn btn-ghost btn-sm" data-filter-clear>@L["Clear filters"]</button>
                </div>
            </details>
            <input type="search" class="list-search" data-list-search="hostagent-jobs-list" placeholder="@L["Search rows"]" aria-label="@L["Search rows"]" />
            <span class="list-count" data-list-count="hostagent-jobs-list" data-template="@L["Showing {0} of {1} rows."]"></span>
        </div>
        <div class="empty-state" data-list-empty="hostagent-jobs-list" hidden>@L["No rows match the current filters."]</div>
        <div class="table-scroll" data-list-message-hint="@L["Click to show the full message"]">
            <table id="hostagent-jobs-list" class="grid hostagent-jobs-grid sortable-list" data-sortable-list data-list-fit data-page-size="25">
                <colgroup>
                    <col class="hostagent-jobs-grid__job" />
                    <col class="hostagent-jobs-grid__host" />
                    <col class="hostagent-jobs-grid__status" />
                    <col class="hostagent-jobs-grid__requested" />
                    <col class="hostagent-jobs-grid__attempts" />
                    <col class="hostagent-jobs-grid__claimed" />
                    <col class="hostagent-jobs-grid__completed" />
                    <col class="hostagent-jobs-grid__message" />
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col" data-sort-type="number"><button type="button" class="sortable-list__button">@L["Job"]</button></th>
                        <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Host"]</button></th>
                        <th scope="col" data-sort-type="number"><button type="button" class="sortable-list__button">@L["Status"]</button></th>
                        <th scope="col" data-sort-type="date"><button type="button" class="sortable-list__button">@L["Requested UTC"]</button></th>
                        <th scope="col" data-sort-type="number"><button type="button" class="sortable-list__button">@L["Attempts"]</button></th>
                        <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Claimed by"]</button></th>
                        <th scope="col" data-sort-type="date"><button type="button" class="sortable-list__button">@L["Completed UTC"]</button></th>
                        <th scope="col">@L["Message"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.RecentHostAgentJobs)
                {
                    <tr>
                        <td data-sort-value="@row.HostAgentJobId">
                            <code>@row.HostAgentJobId</code>
                            <div class="muted">@row.JobType</div>
                        </td>
                        <td data-sort-value="@(row.HostKey ?? string.Empty)">
                            <code>@(string.IsNullOrWhiteSpace(row.HostKey) ? L["Any HostAgent"].Value : row.HostKey)</code>
                            @if (!string.IsNullOrWhiteSpace(row.HostDisplayName))
                            {
                                <div class="muted">@row.HostDisplayName</div>
                            }
                        </td>
                        <td data-sort-value="@row.Status"><span class="pill">@L[MaintenanceModel.FormatHostAgentJobStatus(row.Status)]</span></td>
                        <td data-sort-value="@row.RequestedUtc.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", System.Globalization.CultureInfo.InvariantCulture)">
                            <div>@row.RequestedUtc.ToString("u")</div>
                            @if (!string.IsNullOrWhiteSpace(row.RequestedBy))
                            {
                                <div class="muted">@row.RequestedBy</div>
                            }
                        </td>
                        <td data-sort-value="@row.AttemptCount">@row.AttemptCount / @row.MaxAttempts</td>
                        <td data-sort-value="@(row.ClaimedByServiceName ?? string.Empty)">
                            @if (string.IsNullOrWhiteSpace(row.ClaimedByServiceName))
                            {
                                <span class="muted">@L["None"]</span>
                            }
                            else
                            {
                                <code>@row.ClaimedByServiceName</code>
                                @if (row.ClaimedUtc.HasValue)
                                {
                                    <div class="muted">@row.ClaimedUtc.Value.ToString("u")</div>
                                }
                            }
                        </td>
                        <td data-sort-value="@(row.CompletedUtc?.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", System.Globalization.CultureInfo.InvariantCulture) ?? "")">
                            @if (row.CompletedUtc.HasValue)
                            {
                                @row.CompletedUtc.Value.ToString("u")
                            }
                            else
                            {
                                <span class="muted">@L["None"]</span>
                            }
                        </td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(row.LastError))
                            {
                                <span class="muted">@L["None"]</span>
                            }
                            else
                            {
                                <button type="button" class="list-message">@row.LastError</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section id="@RetentionSectionId" class="card top-gap section-navigator-target">
    <h3>@L["Artifact retention"]</h3>
    <p class="muted">@L["The cleanup groups artifacts by app, package type, and target. If a group contains more versions than the limit, the lowest versions become candidates. Candidates still referenced by desired app, worker, HostAgent, template, or host requirement rows are protected."]</p>

    <form method="post"
          class="form-grid maintenance-retention-form top-gap"
          data-maintenance-retention-form>
        <div class="form-field maintenance-retention-form__versions">
            <label asp-for="Input.MaxVersionsToKeep">@L["Versions to keep"]</label>
            <div class="maintenance-retention-counter">
                <input asp-for="Input.MaxVersionsToKeep"
                       type="number"
                       min="1"
                       max="100"
                       step="1"
                       inputmode="numeric"
                       required
                       data-maintenance-retention-input />
                <div class="maintenance-retention-counter__steps">
                    <button type="button"
                            class="maintenance-retention-counter__step"
                            data-maintenance-retention-step="1"
                            aria-label="@L["Increase"]">
                        +
                    </button>
                    <button type="button"
                            class="maintenance-retention-counter__step"
                            data-maintenance-retention-step="-1"
                            aria-label="@L["Decrease"]">
                        -
                    </button>
                </div>
            </div>
            <span asp-validation-for="Input.MaxVersionsToKeep"></span>
        </div>

        <div class="toolbar maintenance-retention-form__actions">
            <button type="submit"
                    asp-page-handler="Preview"
                    asp-fragment="@RetentionSectionId"
                    class="btn maintenance-retention-action maintenance-retention-action--confirm"
                    data-maintenance-retention-confirm
                    disabled>
                <span class="maintenance-retention-action__icon" aria-hidden="true"></span>
                @L["Confirm change"]
            </button>
            <button type="button"
                    class="btn maintenance-retention-action maintenance-retention-action--cancel"
                    data-maintenance-retention-cancel
                    disabled>
                <span class="maintenance-retention-action__icon" aria-hidden="true"></span>
                @L["Cancel"]
            </button>
            <button type="submit"
                    asp-page-handler="CleanupArtifacts"
                    class="btn maintenance-retention-action maintenance-retention-action--queue"
                    data-omp-confirm="@L["Queue a HostAgent job to delete unreferenced old artifact versions?"]"
                    data-omp-confirm-ok="@L["Queue artifact cleanup"]"
                    data-omp-confirm-cancel="@L["Cancel"]"
                    data-maintenance-retention-queue
                    disabled>
                <span class="maintenance-retention-action__icon" aria-hidden="true"></span>
                @L["Queue artifact cleanup"]
            </button>
        </div>
    </form>

    <div id="@PreviewSectionId"
         class="maintenance-preview section-navigator-target top-gap"
         data-maintenance-preview
         aria-label="@L["Artifact cleanup preview"]">
    <div class="maintenance-preview-summary" aria-label="@L["Artifact cleanup preview"]">
        <div class="card-grid portal-admin-metrics">
            <div class="metric-card maintenance-preview-summary__metric">
                <span class="metric">@Model.Preview.AffectedArtifactIdentityCount</span>
                <span class="metric-card__label">@L["Affected artifact identities"]</span>
            </div>
            <div class="metric-card maintenance-preview-summary__metric">
                <span class="metric">@Model.Preview.CandidateCount</span>
                <span class="metric-card__label">@L["Old version candidates"]</span>
            </div>
            <div class="metric-card maintenance-preview-summary__metric">
                <span class="metric">@Model.Preview.DeletableCandidateCount</span>
                <span class="metric-card__label">@L["Can be deleted"]</span>
            </div>
            <div class="metric-card maintenance-preview-summary__metric">
                <span class="metric">@Model.Preview.ProtectedCandidateCount</span>
                <span class="metric-card__label">@L["Protected by references"]</span>
            </div>
        </div>
    </div>

@if (Model.Preview.Candidates.Count == 0)
{
    <div class="empty-state top-gap">@L["No artifact cleanup candidates found."]</div>
}
else
{
    <div class="toolbar maintenance-preview-actions top-gap">
        <button type="button"
                data-maintenance-preview-expand-all>
            @L["Expand all"]
        </button>
        <button type="button"
                class="btn btn-secondary"
                data-maintenance-preview-collapse-all
                disabled>
            @L["Minimize all"]
        </button>
    </div>

    <div class="maintenance-preview-candidate-list top-gap">
        @foreach (var groupEntry in candidateGroups.Select((group, index) => new { Group = group, Index = index }))
        {
            var group = groupEntry.Group;
            var first = group.First();
            var groupPanelId = $"maintenance-preview-group-{groupEntry.Index}";
            <article class="card maintenance-preview-candidate-card is-collapsed" data-maintenance-preview-group>
                <button type="button"
                        class="maintenance-preview-candidate-card__header"
                        data-maintenance-preview-toggle
                        aria-expanded="false"
                        aria-controls="@groupPanelId">
                    <span class="maintenance-preview-candidate-card__identity">
                        <span class="maintenance-preview-candidate-card__title-row">
                            <span class="maintenance-preview-candidate-card__title">@first.ModuleKey / @first.AppKey</span>
                            <span class="maintenance-preview-candidate-card__arrow" aria-hidden="true"></span>
                        </span>
                        <span class="maintenance-preview-candidate-card__meta">
                            <span class="pill">@first.PackageType</span>
                            @if (!string.IsNullOrWhiteSpace(first.TargetName))
                            {
                                <code>@first.TargetName</code>
                            }
                        </span>
                    </span>
                    <span class="maintenance-preview-candidate-card__summary">
                        <span>@group.Count()</span>
                        <span class="muted">@L["Old version candidates"]</span>
                    </span>
                </button>

                <div id="@groupPanelId" class="table-scroll" data-maintenance-preview-body hidden>
                    <table class="grid maintenance-preview-candidate-grid">
                        <thead>
                            <tr>
                                <th>@L["Artifact"]</th>
                                <th>@L["Version"]</th>
                                <th>@L["Registered"]</th>
                                <th>@L["Rank"]</th>
                                <th>@L["Status"]</th>
                                <th>@L["Relative path"]</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in group)
                        {
                            <tr>
                                <td><code>@row.ArtifactId</code></td>
                                <td>@row.Version</td>
                                <td>@row.CreatedUtc.ToLocalTime().ToString("g", System.Globalization.CultureInfo.CurrentCulture)</td>
                                <td>@row.RetentionRank / @row.TotalVersions</td>
                                <td>
                                    @if (row.IsProtected)
                                    {
                                        <span class="pill" title="@row.ProtectedReferenceSources">@L["Protected"] (@row.ProtectedReferenceCount)</span>
                                        @if (!string.IsNullOrWhiteSpace(row.ProtectedReferenceSources))
                                        {
                                            <div class="muted small-text">@L["Protected by"]: @row.ProtectedReferenceSources</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="pill">@L["Can be deleted"]</span>
                                    }
                                </td>
                                <td><code>@row.RelativePath</code></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </article>
        }
    </div>
}
    </div>
</section>

    </div>
</div>

<script src="~/js/admin-maintenance.js"></script>
