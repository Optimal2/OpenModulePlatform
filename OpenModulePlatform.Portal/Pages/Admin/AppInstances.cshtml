@page
@inject OpenModulePlatform.Web.Shared.Services.OmpTime OmpTime
@model OpenModulePlatform.Portal.Pages.Admin.AppInstancesModel

<section class="page-header">
    <div>
        <div class="eyebrow">@L["Runtime result"]</div>
        <h2>@L["App instances"]</h2>
        <p class="lede">
            @L["App instances show the materialized runtime state. For installation-managed apps, change host placement, version and desired state from System > Installation."]
        </p>
    </div>
</section>

<div class="toolbar top-gap">
    <a class="action-link" href="~/admin/appinstanceedit">@L["Create manual app instance"]</a>
    <a class="action-link" href="~/admin/instancetemplateedit?id=1">@L["Open installation"]</a>
</div>

@await Component.InvokeAsync("OmpFeedback", new { message = Model.StatusMessage })

@if (Model.Rows.Count == 0)
{
    <div class="empty-state">@L["No app instances found."]</div>
}
else
{
    <div class="toolbar top-gap">
        <details class="list-filter" data-list-filter="app-instances-list">
            <summary class="btn btn-ghost">@L["Filter"]<span class="list-filter__count" data-filter-count hidden></span></summary>
            <div class="list-filter__menu">
                <fieldset class="list-filter__group" data-filter-group="allowed">
                    <legend>@L["Allowed"]</legend>
                    <label class="list-filter__option"><input type="checkbox" data-filter-column="8" data-filter-equals="1" /> @L["Allowed"]</label>
                    <label class="list-filter__option"><input type="checkbox" data-filter-column="8" data-filter-equals="0" /> @L["Blocked"]</label>
                </fieldset>
                <button type="button" class="btn btn-ghost btn-sm" data-filter-clear>@L["Clear filters"]</button>
            </div>
        </details>
        <input type="search" class="list-search" data-list-search="app-instances-list" placeholder="@L["Search rows"]" aria-label="@L["Search rows"]" />
        <span class="list-count" data-list-count="app-instances-list" data-template="@L["Showing {0} of {1} rows."]"></span>
    </div>
    <div class="empty-state" data-list-empty="app-instances-list" hidden>@L["No rows match the current filters."]</div>
    <div class="table-scroll app-instances-scroll">
        <table id="app-instances-list" class="grid sortable-list app-instances-grid" data-sortable-list data-page-size="50">
        <thead>
            <tr>
                <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Instance"]</button></th>
                <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Module instance"]</button></th>
                <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["App"]</button></th>
                <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["App instance key"]</button></th>
                <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Host"]</button></th>
                <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Route"]</button></th>
                <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Installation"]</button></th>
                <th scope="col" data-sort-type="text"><button type="button" class="sortable-list__button">@L["Artifact"]</button></th>
                <th scope="col" data-sort-type="number"><button type="button" class="sortable-list__button">@L["Allowed"]</button></th>
                <th scope="col" data-sort-type="date"><button type="button" class="sortable-list__button">@L["Last seen"]</button></th>
                <th scope="col">@L["Actions"]</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td><code>@row.InstanceKey</code></td>
                <td><code>@row.ModuleInstanceKey</code></td>
                <td><code>@row.AppKey</code></td>
                <td><code>@row.AppInstanceKey</code></td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(row.HostKey))
                    {
                        <code>@row.HostKey</code>
                    }
                    else if (!string.IsNullOrWhiteSpace(row.TargetHostTemplateKey))
                    {
                        <code>@L["Host role"]: @row.TargetHostTemplateKey</code>
                    }
                    else
                    {
                        <code>@L["Any host"]</code>
                    }
                </td>
                <td>@row.RoutePath</td>
                <td>@row.InstallationName</td>
                <td>@row.ArtifactVersion</td>
                <td data-sort-value="@(row.IsAllowed ? 1 : 0)"><span class="pill">@(row.IsAllowed ? L["Allowed"] : L["Blocked"])</span></td>
                <td data-sort-value="@OmpTime.UtcIso(row.LastSeenUtc)">@OmpTime.Format(row.LastSeenUtc)</td>
                <td>
                    <div class="admin-icon-actions">
                        <a class="action-link admin-icon-button admin-icon-button--clarify"
                           href="~/admin/appinstanceedit?id=@row.AppInstanceId"
                           title="@L["View"]"
                           aria-label="@L["View"]">
                            <span class="visually-hidden">@L["View"]</span>
                        </a>
                        <form method="post"
                              asp-page-handler="DeleteRuntime"
                              asp-route-appInstanceId="@row.AppInstanceId"
                              class="inline-form"
                              data-omp-confirm="@L["Delete this runtime row? If the installation topology still expects it, HostAgent may recreate it."]"
                              data-omp-confirm-ok="@L["Delete"]"
                              data-omp-confirm-cancel="@L["Cancel"]">
                            <button type="submit"
                                    class="btn btn-link-danger admin-icon-button admin-icon-button--delete"
                                    title="@L["Delete runtime row"]"
                                    aria-label="@L["Delete runtime row"]">
                                <span class="visually-hidden">@L["Delete runtime row"]</span>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
        </table>
    </div>
    <div class="list-show-more">
        <button type="button" class="btn btn-secondary btn-sm" data-list-show-more="app-instances-list" hidden>@L["Show more"]</button>
    </div>
}
