@model OpenModulePlatform.Portal.Models.DashboardWidgetReadiness
@inject OpenModulePlatform.Web.Shared.Services.OmpTime OmpTime
@{
    var storedIssues = Model.DefinitionIssues.Where(static issue => !issue.IsSkippedImport).ToList();
    var skippedImports = Model.DefinitionIssues.Where(static issue => issue.IsSkippedImport).ToList();
}

<h3>@L["Dashboard widget readiness"]</h3>
@if (Model.EndpointIssue != OpenModulePlatform.Portal.Options.ModuleFragmentEndpointIssue.None)
{
    <p role="alert"><partial name="_ModuleFragmentEndpointIssue" model="Model.EndpointIssue" /></p>
}
@if (storedIssues.Count == 0)
{
    <p class="muted">@L["No invalid stored module-fragment widget definitions were found."]</p>
}
else
{
    <p role="alert"><strong>@L["Widget definitions require repair. A HostAgent upgrade alone does not repair previously imported rows."]</strong></p>
    <p>@L["After upgrading HostAgent and Portal, re-import the original universal package, or build one from the original widget files in the package library. Keep the same widget versions."]</p>
    <ol>
        <li>@L["Turn off"] <strong>@L["Quick import"]</strong>.</li>
        <li>@L["Turn on"] <strong>@L["Replace existing dashboard widgets for rollback or repair"]</strong>.</li>
        <li>@L["In the package preview, select only the affected widget definitions and review their permissions before importing. Refresh this page to verify the repair."]</li>
    </ol>
    <div class="toolbar">
        <a class="action-link" href="~/admin/universalpackagebuilder">@L["Create universal package"]</a>
        <a class="action-link" href="~/admin/modulepackageimport">@L["Import/export"]</a>
    </div>
    <div class="table-scroll">
        <table class="grid">
            <thead><tr><th>@L["Widget"]</th><th>@L["Version"]</th><th>@L["Status"]</th></tr></thead>
            <tbody>
            @foreach (var issue in storedIssues)
            {
                <tr>
                    <td><code>@issue.WidgetKey</code> (#@issue.WidgetId)</td>
                    <td>@issue.WidgetVersion</td>
                    <td>@L[issue.IsEnabled ? "Enabled" : "Disabled"]</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
@if (skippedImports.Count > 0)
{
    <h4>@L["Widgets skipped by a HostAgent import"]</h4>
    <p role="alert">@L["These widget definitions were not stored because the importer does not support them. Upgrade HostAgent and Portal, then re-import the package. A row disappears after the same widget key is imported successfully."]</p>
    <div class="table-scroll">
        <table class="grid">
            <thead><tr><th>@L["Widget"]</th><th>@L["Reason"]</th><th>@L["Last seen"]</th></tr></thead>
            <tbody>
            @foreach (var skipped in skippedImports)
            {
                <tr>
                    <td><code>@skipped.WidgetKey</code></td>
                    <td>@skipped.SkipReason</td>
                    <td>@(skipped.SkippedUtc is { } skippedUtc ? OmpTime.Format(skippedUtc) : string.Empty)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
