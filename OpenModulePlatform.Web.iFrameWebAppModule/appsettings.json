// File: OpenModulePlatform.Web.iFrameWebAppModule/appsettings.json
{
  "Portal": {
    "Title": "iFrame Web App Module",
    "DefaultCulture": "sv-SE",
    "SupportedCultures": [
      "sv-SE",
      "en-US"
    ],
    "PortalTopBar": {
      "Enabled": true,
      "PortalBaseUrl": "/"
    },
    "AllowAnonymous": false,
    "UseForwardedHeaders": false,
    "PermissionMode": "Any",
    "SecurityHeaders": {
      "ContentSecurityPolicy": {
        "//": "Baseline with frame-src 'self'; the UseIFrameFrameSourceCsp middleware replaces the frame-src directive per request with an allowlist of the exact origins of the enabled URLs in omp_iframe.urls (cached 60 s), instead of the old 'https: http:' scheme wildcards. script-src has no 'unsafe-inline' since 2026-09-04 (campaign csp-sista-undantagen): the module renders no inline scripts, verified by IFrameCspSmokeTests. See docs/CONTENT_SECURITY_POLICY.md.",
        "Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ws: wss:; media-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'self'; frame-ancestors 'self'"
      }
    }
  },
  "ConnectionStrings": {
    "OmpDb": "Server=localhost;Database=OpenModulePlatform;Integrated Security=true;TrustServerCertificate=true;"
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "variables": {
      "appName": "OpenModulePlatform.Web.iFrameWebAppModule",
      "logDirectory": "${basedir}/logs"
    },
    "targets": {
      "logfile": {
        "type": "File",
        "fileName": "${var:logDirectory}/${var:appName}-${shortdate}.log",
        "layout": "${longdate}|${uppercase:${level}}|${logger}|${message}${onexception:inner= ${exception:format=tostring}}"
      },
      "console": {
        "type": "Console",
        "layout": "${longdate}|${uppercase:${level}}|${logger}|${message}${onexception:inner= ${exception:format=tostring}}"
      }
    },
    "rules": [
      {
        "logger": "Microsoft.Hosting.Lifetime",
        "minLevel": "Info",
        "writeTo": "console,logfile",
        "final": true
      },
      {
        "logger": "Microsoft.*",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "console,logfile"
      }
    ]
  }
}
