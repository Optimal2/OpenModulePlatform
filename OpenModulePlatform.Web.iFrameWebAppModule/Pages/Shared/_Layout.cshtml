@inject OpenModulePlatform.Web.Shared.Services.OmpTime OmpTime
@inject Microsoft.Extensions.Options.IOptions<OpenModulePlatform.Web.Shared.Options.WebAppOptions> WebAppOptions
@{
    var hideModuleTopbar = ViewData["HideModuleTopbar"] is true;
    // Without the shared top bar the module header carries the theme menu itself.
    var showsSharedTopBar = WebAppOptions.Value.PortalTopBar.Enabled;
}
<!doctype html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta name="omp-time-zone" content="@OmpTime.TimeZoneId" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"]</title>
    @* Theme contract (docs/THEME_CONTRACT.md): synchronous, before the stylesheets. *@
    <script src="~/_content/OpenModulePlatform.Web.Shared/js/omp-theme.js"></script>
    <link rel="stylesheet" href="~/_content/OpenModulePlatform.Web.Shared/css/omp-theme.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/_content/OpenModulePlatform.Web.Shared/css/portal-topbar.css" />
    <link rel="stylesheet" href="~/_content/OpenModulePlatform.Web.Shared/css/omp-error-view.css" />
    <link rel="stylesheet" href="~/_content/OpenModulePlatform.Web.Shared/css/omp-toasts.css" />
    @if (ViewData["OmpPreventBackCache"] is true)
    {
        <meta name="omp-prevent-back-cache" content="true" />
    }
</head>
<body class="@(hideModuleTopbar ? "iframe-layout iframe-layout--standalone" : "iframe-layout")" data-omp-toasts="true">
    <header class="app-header">
        @await Component.InvokeAsync("PortalTopBar")
        @if (!hideModuleTopbar)
        {
            <div class="topbar">
                <a class="brand-wrap brand-wrap--link" href="~/" aria-label="@L["Overview"]">
                    <div class="brand">@ViewData["PortalTitle"]</div>
                    <div class="brand-subtitle">@L["iFrame Web App Module"]</div>
                </a>
                <nav class="topbar-nav" aria-label="@L["Select URL"]">
                    @if (IsSectionDefined("ModuleNav"))
                    {
                        @RenderSection("ModuleNav", required: false)
                    }
                </nav>
                @if (!showsSharedTopBar)
                {
                    <div class="app-theme-switch">@await Component.InvokeAsync("OmpThemeSwitch")</div>
                }
            </div>
        }
        else if (!showsSharedTopBar)
        {
            @* Standalone without the shared top bar: a slim row that holds only the theme menu. *@
            <div class="topbar topbar--theme-only">
                <div class="app-theme-switch">@await Component.InvokeAsync("OmpThemeSwitch")</div>
            </div>
        }
    </header>
    <main class="content-shell">
        @RenderBody()
    </main>
    <script src="~/_content/OpenModulePlatform.Web.Shared/js/portal-topbar.js"></script>
    <script src="~/_content/OpenModulePlatform.Web.Shared/js/omp-secure-page-navigation.js"></script>
    <script src="~/_content/OpenModulePlatform.Web.Shared/js/omp-toasts.js"></script>
</body>
</html>
