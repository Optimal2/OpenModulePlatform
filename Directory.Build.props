<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <Company>OpenModulePlatform</Company>
    <Product>OpenModulePlatform</Product>
    <Authors>OpenModulePlatform contributors</Authors>
    <NeutralLanguage>en</NeutralLanguage>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!--
      Keep the git commit OUT of AssemblyInformationalVersion.

      The SDK appends "+<commit sha>" to InformationalVersion by default, which
      means every project in this repository produces different assembly bytes
      after every commit, whether or not its own sources changed. Artifact
      identity is manifest version plus SHA-256 of the payload, so that turned
      each commit into "artifact content changed under the same version" for
      every component the build touched - and bumping the versions to fix it is
      itself a commit, which invalidates them again. Measured 2026-08-23: an
      import failed on 13 components at once whose only difference was
      0.1.0+51931bb... versus 0.1.0+aa52071..., with no source change between.

      Nothing is lost by removing it. The commit that produced an artifact is
      recorded where it belongs - in the artifact build stamp next to the package
      and in git - rather than inside the binary, where it silently defeats
      content-based artifact identity.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    Opt-in per-caller isolation of build intermediates and output for OMP
    projects. Consumer repositories pass -p:OmpIsolatedBuildRoot=<folder inside
    the consumer repo> from scripts/local-ci.ps1, so parallel builds in sibling
    repositories never share obj/bin folders for the OMP projects they
    reference (Web.Shared, Web.Shared.Analyzers, EventPublisher.*). That makes
    the CS2012 "file locked by VBCSCompiler" collision physically impossible.
    When the property is not set, the default in-tree obj/bin layout is used,
    so OMP's own builds are unaffected.
  -->
  <PropertyGroup Condition="'$(OmpIsolatedBuildRoot)' != ''">
    <BaseIntermediateOutputPath>$(OmpIsolatedBuildRoot)\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <BaseOutputPath>$(OmpIsolatedBuildRoot)\bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>

  <!--
    The SDK's default Compile glob excludes $(BaseIntermediateOutputPath) and
    $(BaseOutputPath), so once those move out of the project directory, stale
    files in the default in-tree obj/bin (from non-isolated builds) would be
    globbed in as sources (duplicate AssemblyInfo attributes). Exclude them.
  -->
  <PropertyGroup Condition="'$(OmpIsolatedBuildRoot)' != ''">
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\bin\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
