<Project TreatAsLocalProperty="PathMap">
  <PropertyGroup>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <Company>OpenModulePlatform</Company>
    <Product>OpenModulePlatform</Product>
    <Authors>OpenModulePlatform contributors</Authors>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Normalize compiler inputs for installer/local builds as well as CI.
         Deterministic explicitly fixes MVID/PE timestamps to the input content;
         portable symbols retain debugging without embedding machine paths. -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>

    <!--
      Keep the git commit OUT of AssemblyInformationalVersion.

      The SDK appends "+<commit sha>" to InformationalVersion by default, which
      means every project in this repository produces different assembly bytes
      after every commit, whether or not its own sources changed. Artifact
      identity is manifest version plus SHA-256 of the payload, so that turned
      each commit into "artifact content changed under the same version" for
      every component the build touched - and bumping the versions to fix it is
      itself a commit, which invalidates them again. Measured 2026-08-23: an
      import failed on 13 components at once whose only difference was
      0.1.0+51931bb... versus 0.1.0+aa52071..., with no source change between.

      Nothing is lost by removing it. The commit that produced an artifact is
      recorded where it belongs - in the artifact build stamp next to the package
      and in git - rather than inside the binary, where it silently defeats
      content-based artifact identity.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!--
      And stop the SDK from querying git at all.

      Clearing the informational version was not enough: SourceLink is built into
      the SDK since .NET 8 and needs no package, so _GenerateSourceLinkFile still
      ran, embedded the commit in the PDB, and changed the assembly's MVID and PE
      timestamp. Measured: a git commit with NO file changes at all produced a
      different assembly, and resetting back to the previous commit reproduced
      the original bytes exactly - the build is deterministic per commit, which
      is precisely the problem when artifact identity is a content hash.

      Source Link is worth having in a published build; CI can set
      EnableSourceControlManagerQueries=true when that is wanted. Locally it costs
      every artifact its identity on every commit, and this repository ships
      artifacts, not NuGet packages.
    -->
    <EnableSourceControlManagerQueries Condition="'$(GITHUB_ACTIONS)' != 'true'">false</EnableSourceControlManagerQueries>
  </PropertyGroup>

  <!--
    Opt-in per-caller isolation of build intermediates and output for OMP
    projects. Consumer repositories pass -p:OmpIsolatedBuildRoot=<absolute
    folder inside the consumer repo> from scripts/local-ci.ps1, so parallel
    builds in sibling repositories never share obj/bin folders for the OMP
    projects they reference (Web.Shared, Web.Shared.Analyzers, EventPublisher.*).
    That makes the CS2012 "file locked by VBCSCompiler" collision physically
    impossible. When the property is not set, the default in-tree obj/bin layout
    is used, so OMP's own builds are unaffected.

    The value must be an absolute path outside this repository. MSBuild resolves
    a RELATIVE value against each project, so a hand-run
    -p:OmpIsolatedBuildRoot=artifacts\omp-isolated-build once wrote obj/bin into
    <OMP project>\artifacts\omp-isolated-build, and the next build globbed the
    generated AssemblyInfo files in as sources (CS0579). An invalid value is not
    applied here, and Directory.Build.targets stops the build with OMPBUILD001
    (relative) or OMPBUILD002 (inside this repository).

    "Absolute" on Windows means a drive letter followed by a separator, or a
    UNC path: IsPathRooted('C:artifacts') is true, but that path resolves
    against the current directory of drive C:, which may be this repository.

    "Inside this repository" is checked twice, because the same folder can be
    named through a junction (AI Orchestrator instances reach the repositories
    that way) or by an 8.3 short name, and GetFullPath resolves neither. The
    string comparison catches the plain form; GetDirectoryNameOfFileAbove
    walks up from the root with File.Exists, which the file system resolves
    through any junction or short name, and finds OpenModulePlatform.slnx at
    the root of this repository (or of any other OpenModulePlatform checkout,
    which is no better a place for a consumer's obj/bin). A symbolic link or
    junction BELOW an existing folder of the root that points into this
    repository is not detected: the walk only looks at the root's ancestors.
  -->
  <PropertyGroup Condition="'$(OmpIsolatedBuildRoot)' != ''">
    <_OmpIsolatedBuildRootIsRooted Condition="$([MSBuild]::IsOSPlatform('Windows'))">$([System.Text.RegularExpressions.Regex]::IsMatch('$(OmpIsolatedBuildRoot)', '^([A-Za-z]:[\\/]|[\\/][\\/])'))</_OmpIsolatedBuildRootIsRooted>
    <_OmpIsolatedBuildRootIsRooted Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$([System.IO.Path]::IsPathRooted('$(OmpIsolatedBuildRoot)'))</_OmpIsolatedBuildRootIsRooted>
    <_OmpRepositoryRootFull>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)').ToUpperInvariant())</_OmpRepositoryRootFull>
    <_OmpIsolatedBuildRootFull Condition="'$(_OmpIsolatedBuildRootIsRooted)' == 'true'">$([System.IO.Path]::GetFullPath('$(OmpIsolatedBuildRoot)\').ToUpperInvariant())</_OmpIsolatedBuildRootFull>
    <_OmpIsolatedBuildRootInsideRepository Condition="'$(_OmpIsolatedBuildRootFull)' != '' and $([System.String]::Copy('$(_OmpIsolatedBuildRootFull)').StartsWith('$(_OmpRepositoryRootFull)'))">true</_OmpIsolatedBuildRootInsideRepository>
    <_OmpIsolatedBuildRootCheckout Condition="'$(_OmpIsolatedBuildRootFull)' != ''">$([MSBuild]::GetDirectoryNameOfFileAbove('$(_OmpIsolatedBuildRootFull)', 'OpenModulePlatform.slnx'))</_OmpIsolatedBuildRootCheckout>
    <_OmpIsolatedBuildRootInsideRepository Condition="'$(_OmpIsolatedBuildRootCheckout)' != ''">true</_OmpIsolatedBuildRootInsideRepository>
    <_OmpIsolatedBuildRootIsValid Condition="'$(_OmpIsolatedBuildRootIsRooted)' == 'true' and '$(_OmpIsolatedBuildRootInsideRepository)' != 'true'">true</_OmpIsolatedBuildRootIsValid>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_OmpIsolatedBuildRootIsValid)' == 'true'">
    <BaseIntermediateOutputPath>$(OmpIsolatedBuildRoot)\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <BaseOutputPath>$(OmpIsolatedBuildRoot)\bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>

  <!--
    SourceLink is intentionally optional above, so its source-root mapping is
    not sufficient for local builds. Map the checkout ourselves: this covers
    PDB documents, CallerFilePath literals and the PE CodeView PDB path.
    Isolated obj/bin have a different layout (obj/Project instead of Project/obj);
    map those more-specific prefixes first to the SAME virtual in-tree layout.
    PathMap is local so a package caller's global PathMap cannot suppress these
    OMP mappings; retain that caller mapping last for any other source roots.
  -->
  <PropertyGroup>
    <_OmpCallerPathMap>$(PathMap)</_OmpCallerPathMap>
    <PathMap>$(MSBuildThisFileDirectory)=/_/openmoduleplatform/</PathMap>
    <PathMap Condition="'$(_OmpIsolatedBuildRootIsValid)' == 'true'">$([MSBuild]::EnsureTrailingSlash('$(BaseIntermediateOutputPath)'))=/_/openmoduleplatform/$(MSBuildProjectName)/obj/,$([MSBuild]::EnsureTrailingSlash('$(BaseOutputPath)'))=/_/openmoduleplatform/$(MSBuildProjectName)/bin/,$(PathMap)</PathMap>
    <PathMap Condition="'$(_OmpCallerPathMap)' != ''">$(PathMap),$(_OmpCallerPathMap)</PathMap>
  </PropertyGroup>

  <!--
    The SDK's default Compile glob excludes $(BaseIntermediateOutputPath) and
    $(BaseOutputPath), so once those move out of the project directory, stale
    files in the default in-tree obj/bin (from non-isolated builds) would be
    globbed in as sources (duplicate AssemblyInfo attributes). Exclude them.
  -->
  <PropertyGroup Condition="'$(_OmpIsolatedBuildRootIsValid)' == 'true'">
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\bin\**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    No OMP project keeps sources in a folder named artifacts; the name is only
    ever build or package output. Keep <project>\artifacts\** out of the default
    globs unconditionally, so an isolation folder left behind by an earlier
    relative OmpIsolatedBuildRoot is never compiled into a later build.
  -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\artifacts\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
