{
  "OmpTime": {
    "TimeZoneId": "UTC"
  },
  "Portal": {
    "Title": "Context Guard Module",
    "DefaultCulture": "sv-SE",
    "SupportedCultures": [ "sv-SE", "en-US" ],
    "PortalTopBar": {
      "Enabled": false,
      "PortalBaseUrl": "/"
    },
    "AllowAnonymous": false,
    "UseForwardedHeaders": false,
    "PermissionMode": "Any"
  },
  "ContextGuard": {
    "HandoffTtlSeconds": 60,
    "HeartbeatIntervalSeconds": 5,
    "HeartbeatTimeoutSeconds": 30,
    "HeartbeatFailureLimit": 3,
    "MaxPendingHandoffs": 100,
    "MaxFieldCount": 64,
    "MaxTotalFormBytes": 65536,
    "MaxFieldValueLength": 8192,
    "Scope": "user",
    "Profiles": {
      "example": {
        "DisplayName": "Example calling profile",
        "TargetUrl": "http://localhost:5099/target",
        "Method": "POST",
        "Delivery": "embed",
        "AllowedFieldNames": [ "correlation", "contextReference" ],
        "CorrelationFieldName": "correlation",
        "AllowedOriginHosts": []
      }
    }
  },
  "ConnectionStrings": {
    "OmpDb": "Server=localhost;Database=OpenModulePlatform;Integrated Security=true;TrustServerCertificate=true;"
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "variables": {
      "appName": "OpenModulePlatform.Web.ContextGuardModule",
      "logDirectory": "${basedir}/logs"
    },
    "targets": {
      "logfile": {
        "type": "File",
        "fileName": "${var:logDirectory}/${var:appName}-${shortdate}.log",
        "layout": "${longdate}|${uppercase:${level}}|${logger}|${scopeproperty:item=CorrelationId}|${message}${onexception:inner= ${exception:format=tostring}}"
      },
      "console": {
        "type": "Console",
        "layout": "${longdate}|${uppercase:${level}}|${logger}|${scopeproperty:item=CorrelationId}|${message}${onexception:inner= ${exception:format=tostring}}"
      }
    },
    "rules": [
      {
        "logger": "Microsoft.Hosting.Lifetime",
        "minLevel": "Info",
        "writeTo": "console,logfile",
        "final": true
      },
      {
        "logger": "Microsoft.*",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "console,logfile"
      }
    ]
  }
}
