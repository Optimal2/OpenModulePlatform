@model OpenModulePlatform.Web.Shared.Navigation.SectionNavigatorModel

@if (Model.Items.Count > 0)
{
    @* The pane wrapper carries the shared pane behavior (narrow-screen
       collapse to the left edge, full-height grab edge), so every page
       that renders the navigator gets it. Pages composing their own pane
       around the navigator opt out via WrapInPane. *@
    if (Model.WrapInPane)
    {
        <div class="section-navigator-pane">
            @await Html.PartialAsync("~/Views/Shared/Components/SectionNavigator/_SectionNavigatorAside.cshtml", Model)
        </div>
    }
    else
    {
        @await Html.PartialAsync("~/Views/Shared/Components/SectionNavigator/_SectionNavigatorAside.cshtml", Model)
    }
}
