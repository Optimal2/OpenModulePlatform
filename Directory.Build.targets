<Project InitialTargets="OmpValidateIsolatedBuildRoot">

  <!--
    Stop a build whose OmpIsolatedBuildRoot would put obj/bin of OMP projects
    inside this repository. Directory.Build.props computes the flags and does
    not apply an invalid root; this target turns that into an error before
    anything is compiled. InitialTargets runs for every target of every OMP
    project, including the restore walk of a consumer build.
  -->
  <Target Name="OmpValidateIsolatedBuildRoot" Condition="'$(OmpIsolatedBuildRoot)' != ''">
    <Error Code="OMPBUILD001"
           Condition="'$(_OmpIsolatedBuildRootIsRooted)' != 'true'"
           Text="OmpIsolatedBuildRoot='$(OmpIsolatedBuildRoot)' is a relative path. MSBuild resolves it against every referenced OpenModulePlatform project, so their obj and bin folders would be written into the OpenModulePlatform repository ($(MSBuildThisFileDirectory)). Pass an absolute path inside the consuming repository's own tree, for example -p:OmpIsolatedBuildRoot=C:\src\MyConsumer\artifacts\omp-isolated-build, or build through that repository's scripts/local-ci.ps1, which already does this." />
    <Error Code="OMPBUILD002"
           Condition="'$(_OmpIsolatedBuildRootInsideRepository)' == 'true'"
           Text="OmpIsolatedBuildRoot='$(OmpIsolatedBuildRoot)' lies inside the OpenModulePlatform repository ($(MSBuildThisFileDirectory)). Isolated build output belongs to the caller: pass an absolute path inside the consuming repository's own tree, for example -p:OmpIsolatedBuildRoot=C:\src\MyConsumer\artifacts\omp-isolated-build. Builds of OpenModulePlatform itself need no OmpIsolatedBuildRoot." />
  </Target>

  <!--
    Make the OMP web defaults analyzer run automatically for every ASP.NET Core
    web project in the repository that uses Microsoft.NET.Sdk.Web.
    OpenModulePlatform.Auth is excluded at the analyzer level because it
    deliberately uses its own pipeline.
  -->
  <ItemGroup Condition="'$(UsingMicrosoftNETSdkWeb)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)OpenModulePlatform.Web.Shared.Analyzers\OpenModulePlatform.Web.Shared.Analyzers.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <!--
    Keep the published static web assets endpoints manifest free of file system
    timestamps, so the same source at the same version gives the same artifact
    SHA-256 regardless of when or where it was checked out.
  -->
  <Import Project="$(MSBuildThisFileDirectory)build\OpenModulePlatform.DeterministicStaticWebAssets.targets" />

</Project>
