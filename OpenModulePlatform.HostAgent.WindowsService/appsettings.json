{
  "ConnectionStrings": {
    "OmpDb": ""
  },
  "HostAgent": {
    "ServiceName": "OMP.HostAgent",
    "HostKey": "",
    "HostName": "",
    "RefreshSeconds": 30,
    "CentralArtifactRoot": "",
    "LocalArtifactCacheRoot": "",
    "MaterializeTemplates": true,
    "ProcessHostDeployments": true,
    "ProvisionAppInstanceArtifacts": true,
    "ProvisionExplicitRequirements": true,
    "ProcessHostAgentJobs": true,
    "MaxHostAgentJobsPerCycle": 5,
    "PortalHealthCheck": {
      "Enabled": true,
      "HealthKey": "portal",
      "DisplayName": "OMP Portal",
      "Path": "/health/ready",
      "TimeoutSeconds": 10,
      "FailureThreshold": 3,
      "AutoRecycleAppPool": false,
      "AutoRecycleCooldownMinutes": 15,
      "AllowInvalidTlsCertificate": false
    },
    "ResourceTelemetry": {
      "Enabled": true,
      "SampleIntervalSeconds": 60,
      "SampleWindowSeconds": 1,
      "MaxSamplesPerCycle": 200,
      "BucketMinutes": 5,
      "RetainHours": 168,
      "RetainDays": 400,
      "PruneIntervalSeconds": 3600,
      "CollectIisAppPools": true,
      "CollectServiceProcesses": true,
      "CollectWorkerProcesses": true
    },
    "ArtifactZipImport": {
      "IsEnabled": false,
      "ImportPath": "",
      "ProcessedPath": "",
      "FailedPath": "",
      "MaxFilesPerCycle": 10,
      "CopyConfigurationFilesFromPreviousVersion": true
    },
    "CredentialStore": {
      "AutomationMode": "Disabled",
      "FilePath": "",
      "ProtectionScope": "LocalMachine",
      "EntropyPurpose": "OpenModulePlatform.HostAgent.CredentialStore.v1"
    },
    "ServiceAppUserName": "",
    "ServiceAppPasswordCredentialKey": "",
    "ServiceAppIdentityOverrides": {},
    "SelfUpgrade": {
      "PreparedServiceStartupVerificationDelaySeconds": 3
    },
    "MaxArtifactsPerCycle": 100,
    "EnableRpc": true,
    "RpcPipeName": "",
    "RpcAllowedClientAccounts": [],
    "RpcAllowedClientServiceNames": [],
    "RpcRequestTimeoutSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "extensions": [
      { "assembly": "NLog.Database" }
    ],
    "variables": {
      "appName": "OpenModulePlatform.HostAgent.WindowsService",
      "logDirectory": "${basedir}/logs"
    },
    "targets": {
      "systemlog": {
        "type": "AsyncWrapper",
        "overflowAction": "Discard",
        "queueLimit": 2000,
        "target": {
          "type": "Database",
          "dbProvider": "Microsoft.Data.SqlClient.SqlConnection, Microsoft.Data.SqlClient",
          "connectionString": "${configsetting:item=ConnectionStrings.OmpDb}",
          "keepConnection": false,
          "commandText": "INSERT INTO omp.SystemLog (LoggedUtc, HostName, ProcessName, Level, Logger, Message, Exception, CorrelationId) VALUES (@LoggedUtc, @HostName, @ProcessName, @Level, @Logger, @Message, @Exception, @CorrelationId)",
          "parameters": [
            { "name": "@LoggedUtc", "layout": "${date:universalTime=true:format=yyyy-MM-dd HH\\:mm\\:ss.fff}", "dbType": "DbType.DateTime2" },
            { "name": "@HostName", "layout": "${machinename}", "dbType": "DbType.String", "size": 128 },
            { "name": "@ProcessName", "layout": "${var:appName}", "dbType": "DbType.String", "size": 128 },
            { "name": "@Level", "layout": "${level}", "dbType": "DbType.String", "size": 16 },
            { "name": "@Logger", "layout": "${logger}", "dbType": "DbType.String", "size": 256 },
            { "name": "@Message", "layout": "${message}", "dbType": "DbType.String" },
            { "name": "@Exception", "layout": "${exception:format=tostring}", "dbType": "DbType.String", "allowDbNull": true },
            { "name": "@CorrelationId", "layout": "${scopeproperty:item=CorrelationId}", "dbType": "DbType.String", "size": 64, "allowDbNull": true }
          ]
        }
      },
      "logfile": {
        "type": "File",
        "fileName": "${var:logDirectory}/${var:appName}-${shortdate}.log",
        "maxArchiveDays": 14,
        "layout": "${longdate}|${uppercase:${level}}|${logger}|${message}${onexception:inner= ${exception:format=tostring}}"
      },
      "console": {
        "type": "Console",
        "layout": "${longdate}|${uppercase:${level}}|${logger}|${message}${onexception:inner= ${exception:format=tostring}}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Warn",
        "writeTo": "systemlog"
      },
      {
        "logger": "Microsoft.Hosting.Lifetime",
        "minLevel": "Info",
        "writeTo": "console,logfile",
        "final": true
      },
      {
        "logger": "Microsoft.*",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "console,logfile"
      }
    ]
  }
}
