<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenModulePlatform.WorkerManager.WindowsService\OpenModulePlatform.WorkerManager.WindowsService.csproj" />
    <ProjectReference Include="..\OpenModulePlatform.WorkerProcessHost\OpenModulePlatform.WorkerProcessHost.csproj" />
    <ProjectReference Include="..\OpenModulePlatform.WorkerProcessHost.TestPlugin\OpenModulePlatform.WorkerProcessHost.TestPlugin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared test support, linked rather than copied (see tests/shared). -->
    <Compile Include="..\tests\shared\OmpRepositoryFiles.cs" Link="TestSupport\OmpRepositoryFiles.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
