@page "/configurations/edit"
@page "/configurations/edit/{ConfigId:int}"
@using OpenModulePlatform.Web.ExampleWebAppBlazorModule.Localization
@using OpenModulePlatform.Web.Shared.Configuration
@inherits ExampleWebAppBlazorModuleComponentBase
@using OpenModulePlatform.Web.Shared.ActivityLog
@using OpenModulePlatform.Web.Shared.Security
@inject ExampleWebAppBlazorModuleAdminRepository Repo
@inject ActivityLogWriter ActivityLog

<PageTitle>@PageTitle</PageTitle>

@if (!AuthorizationResolved)
{
    <div class="empty-state">@L["Loading configuration..."]</div>
}
else if (PageError is not null)
{
    <OmpErrorView Model="@PageError" />
}
else
{
    <div class="page-header">
        <div>
            <div class="eyebrow">@L["Example module"]</div>
            <h1>@L["Edit configuration"]</h1>
            <p class="lede">@L["Update comment and JSON content for the selected configuration."]</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="card status-banner">@StatusMessage</div>
    }

    <EditForm Model="Input" OnValidSubmit="SaveAsync" class="card form-grid">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-field">
                <label for="comment">@L["Comment"]</label>
                <InputText id="comment" @bind-Value="Input.Comment" />
            </div>

            <div class="form-field">
                <label for="configJson">@L["Config JSON"]</label>
                <InputTextArea id="configJson" @bind-Value="Input.ConfigJson" />
                <ValidationMessage For="@(() => Input.ConfigJson)" />
            </div>

            <div class="toolbar">
                <button type="submit">@L["Save"]</button>
                <NavLink class="action-link" href="configurations">@L["Back to configurations"]</NavLink>
            </div>
        </EditForm>
}

@code {
    [Parameter]
    public int? ConfigId { get; set; }

    [SupplyParameterFromQuery(Name = "configId")]
    public int? QueryConfigId { get; set; }

    private EditInput Input { get; set; } = new();
    private string? StatusMessage { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        SetPageTitle(L["Edit configuration"]);
        StatusMessage = null;

        if (!await EnsureAnyPermissionAsync(CancellationToken.None, ExampleWebAppBlazorModulePermissions.Admin))
        {
            return;
        }

        var effectiveConfigId = ConfigId ?? QueryConfigId;
        if (effectiveConfigId is null || effectiveConfigId.Value <= 0)
        {
            ShowNotFoundError(L["No valid configId was provided."].Value);
            return;
        }

        var row = await Repo.GetConfigurationAsync(new ModuleConfigId(effectiveConfigId.Value), CancellationToken.None);
        if (row is null)
        {
            ShowNotFoundError(L["The configuration was not found."].Value);
            return;
        }

        ClearPageError();
        Input = new EditInput
        {
            ConfigId = row.ConfigId,
            Comment = row.Comment,
            ConfigJson = row.ConfigJson
        };
    }

    private async Task SaveAsync()
    {
        if (!IsAuthorized)
        {
            return;
        }

        var updated = await Repo.UpdateConfigurationAsync(
            Input.ConfigId,
            Input.ConfigJson,
            Input.Comment,
            CurrentUserName,
            CancellationToken.None);
        if (!updated)
        {
            ShowNotFoundError(L["The configuration was not found."].Value);
            return;
        }

        // The user log says that the configuration was saved and which one,
        // never what it contains or what the comment said. The principal comes
        // from the cascading authentication state the component base resolved;
        // an anonymous save (development mode) is not a person the log can
        // name, so nothing is written then.
        if (OmpUserIdentity.TryGetOmpUserId(CurrentUser) is not null)
        {
            await ActivityLog.WriteAsync(new ActivityEntry
            {
                Event = "configuration.saved",
                Summary = $"Saved configuration {Input.ConfigId.Value}",
                Subject = new ActivitySubject("configuration", Input.ConfigId.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))
            }, CurrentUser, CancellationToken.None);
        }

        StatusMessage = L["Configuration updated."];
    }

    private sealed class EditInput
    {
        public ModuleConfigId ConfigId { get; set; }

        [Display(Name = "Comment")]
        public string? Comment { get; set; }

        [Required]
        [Display(Name = "Config JSON")]
        public string ConfigJson { get; set; } = "{}";
    }
}
