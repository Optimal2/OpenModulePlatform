<Project>

  <!--
    Deterministic publish endpoints manifest for static web assets.

    The SDK writes a "Last-Modified" response header for every static web asset
    endpoint into <app>.staticwebassets.endpoints.json, and takes its value from
    the file system timestamp of the asset (and of the .gz/.br files the build
    compresses). A fresh checkout or worktree gives every file a new timestamp,
    so the same source at the same component version published a different
    endpoints manifest - and therefore a different artifact SHA-256. Measured
    2026-09-28: an import rejected content-webapp 0.3.316, omp-auth 0.3.321 and
    iframe-webapp 0.3.309 with "The artifact content has changed under the same
    version"; in each the ONLY differing payload file was the endpoints manifest,
    and it was byte-identical once the Last-Modified values were ignored.

    The fix pins every Last-Modified value in the PUBLISH manifest to a fixed
    date. Caching stays correct: every endpoint also carries a strong ETag that
    is the SHA-256 of the served content, and ASP.NET Core static assets take the
    If-None-Match result over If-Modified-Since, so changed content is still
    served in full. The build (development) manifest is left untouched.

    Imported by this repository's Directory.Build.targets. Repositories that
    publish web projects referencing OpenModulePlatform.Web.Shared should import
    this file from their own Directory.Build.targets as well, because the
    manifest is generated by the consuming web project, not by Web.Shared.
  -->
  <PropertyGroup>
    <OmpStaticWebAssetsFixedLastModified Condition="'$(OmpStaticWebAssetsFixedLastModified)' == ''">Sat, 01 Jan 2000 00:00:00 GMT</OmpStaticWebAssetsFixedLastModified>
  </PropertyGroup>

  <Target Name="OmpNormalizeStaticWebAssetsPublishEndpointsLastModified"
          AfterTargets="GenerateStaticWebAssetsPublishManifest"
          Condition="'$(OmpDeterministicStaticWebAssets)' != 'false' And '$(StaticWebAssetEndpointsPublishManifestPath)' != '' And Exists('$(StaticWebAssetEndpointsPublishManifestPath)')">
    <PropertyGroup>
      <_OmpEndpointsManifestText>$([System.IO.File]::ReadAllText('$(StaticWebAssetEndpointsPublishManifestPath)'))</_OmpEndpointsManifestText>
      <_OmpEndpointsManifestNormalized>$([System.Text.RegularExpressions.Regex]::Replace('$(_OmpEndpointsManifestText)', '("Name"\s*:\s*"Last-Modified"\s*,\s*"Value"\s*:\s*")[^"]*(")', '${1}$(OmpStaticWebAssetsFixedLastModified)${2}'))</_OmpEndpointsManifestNormalized>
    </PropertyGroup>

    <WriteLinesToFile File="$(StaticWebAssetEndpointsPublishManifestPath)"
                      Lines="$([MSBuild]::Escape('$(_OmpEndpointsManifestNormalized)'))"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Condition="'$(_OmpEndpointsManifestNormalized)' != '$(_OmpEndpointsManifestText)'" />
  </Target>

</Project>
