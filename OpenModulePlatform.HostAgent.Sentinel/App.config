<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
  <appSettings>
    <add key="PollIntervalSeconds" value="30" />
    <add key="OkHeartbeatMinutes" value="10" />
    <add key="StopSelfWhenHostAgentDown" value="true" />
    <add key="CheckDatabaseHeartbeat" value="false" />
    <add key="HeartbeatStaleMinutes" value="15" />
    <!-- Empty disables DB access, even when CheckDatabaseHeartbeat is true.
         Use Integrated Security only; never put credentials here. -->
    <add key="DatabaseConnectionString" value="" />
  </appSettings>
</configuration>
