#!/bin/sh
# OpenModulePlatform pre-push hook wrapper (Git Bash / MSYS).
# The real implementation lives in pre-push.ps1 and must be PowerShell 5.1-safe.
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
# A PSModulePath inherited from PowerShell 7 (e.g. when git runs under a pwsh-launched shell)
# makes Windows PowerShell 5.1 load 7.x module paths, and cmdlets such as
# Import-PowerShellDataFile then resolve to nothing, failing the gate spuriously.
# Unset it so 5.1 rebuilds its own default module path.
exec env -u PSModulePath powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File "$SCRIPT_DIR/pre-push.ps1"
