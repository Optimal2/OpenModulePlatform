<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <!--
      Roslyn/SDK coupling (verified 2026-08-31):
      global.json pins SDK 10.0.400, which ships Roslyn 5.9.
      OmpWebDefaultsAnalyzer is compiled against
      Microsoft.CodeAnalysis.CSharp and loaded as a build-time analyzer into
      every SDK-style web project (Directory.Build.targets), i.e. into the
      SDK's own compiler host. An analyzer built against a NEWER Roslyn than
      the host fails to load (build error); older-than-host is fine. So the
      package pin must stay <= the Roslyn of the oldest allowed SDK band
      (10.0.400 -> Roslyn 5.9). Keep CSharp and CSharp.Workspaces aligned with
      that host version and coordinate future Roslyn updates with global.json.
      The 5.9 upgrade was validated end-to-end; the analyzer still uses only
      long-stable Roslyn APIs.
      Microsoft.CodeAnalysis.Analyzers (RS rule analyzers, PrivateAssets=all)
      is build-time-only and version-independent; it may float freely.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="NLog.Extensions.Hosting" Version="6.2.0" />
    <PackageVersion Include="NLog.Web.AspNetCore" Version="6.2.0" />
    <PackageVersion Include="System.DirectoryServices.AccountManagement" Version="10.0.11" />
    <PackageVersion Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
    <PackageVersion Include="System.Management" Version="10.0.11" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageVersion Include="System.Security.Permissions" Version="10.0.11" />
    <!--
      Runner/core compatibility baseline (verified 2026-08-31):
      xunit.runner.visualstudio 4.0.0 explicitly supports .NET test projects
      built with xUnit.net v2 and v3. The adapter major does not require a
      migration from the xunit v2 core package to xunit.v3. Keep the latest
      v2 core (2.9.3) until a separate, deliberate v3 migration is approved.
      Repositories linking tests/shared/Ui/*.cs should use these exact pins.
    -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>
</Project>
